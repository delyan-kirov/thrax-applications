$ @mod CFG

# \file CFG.thx
# \info The compilation target. alec targets WebAssembly with either memory
#       model: wasm32 is ILP32 (int, long and pointers are 4 bytes), wasm64 is
#       LP64 (long and pointers are 8). Everything that depends on the target,
#       from `sizeof (long)` to the address type of a load, reads it from here.

$ Target : @struct =
	name : @str,
	ptr : @int,
	long : @int,
	wasm64 : @bool,

$ wasm32 : Target = Target.{ .name = "wasm32", .ptr = 4, .long = 4, .wasm64 = @false }
$ wasm64 : Target = Target.{ .name = "wasm64", .ptr = 8, .long = 8, .wasm64 = @true }

# The predefined macros, as source the preprocessor reads before the first file.
$ predefined : Target -> @str = \t =
	let lp = t.long == 8 in
	"#define __STDC__ 1\n"
	++ "#define __STDC_VERSION__ 201112L\n"
	++ "#define __STDC_HOSTED__ 1\n"
	++ "#define __STDC_UTF_16__ 1\n"
	++ "#define __STDC_UTF_32__ 1\n"
	++ "#define __STDC_NO_ATOMICS__ 1\n"
	++ "#define __STDC_NO_COMPLEX__ 1\n"
	++ "#define __STDC_NO_THREADS__ 1\n"
	++ "#define __STDC_NO_VLA__ 1\n"
	++ "#define __alec__ 1\n"
	++ "#define __wasm__ 1\n"
	++ (if t.wasm64 => "#define __wasm64__ 1\n#define __wasm64 1\n#define __LP64__ 1\n#define _LP64 1\n"
	    else "#define __wasm32__ 1\n#define __wasm32 1\n#define __ILP32__ 1\n#define _ILP32 1\n")
	++ "#define __CHAR_BIT__ 8\n"
	++ "#define __SIZEOF_SHORT__ 2\n"
	++ "#define __SIZEOF_INT__ 4\n"
	++ "#define __SIZEOF_LONG__ " ++ to_string t.long ++ "\n"
	++ "#define __SIZEOF_LONG_LONG__ 8\n"
	++ "#define __SIZEOF_POINTER__ " ++ to_string t.ptr ++ "\n"
	++ "#define __SIZEOF_FLOAT__ 4\n"
	++ "#define __SIZEOF_DOUBLE__ 8\n"
	++ "#define __SIZEOF_LONG_DOUBLE__ 8\n"
	++ "#define __SIZEOF_SIZE_T__ " ++ to_string t.ptr ++ "\n"
	++ "#define __SIZEOF_WCHAR_T__ 4\n"
	++ "#define __SCHAR_MAX__ 127\n"
	++ "#define __SHRT_MAX__ 32767\n"
	++ "#define __INT_MAX__ 2147483647\n"
	++ "#define __LONG_MAX__ " ++ (if lp => "9223372036854775807L" else "2147483647L") ++ "\n"
	++ "#define __LONG_LONG_MAX__ 9223372036854775807LL\n"
	++ "#define __SIZE_MAX__ " ++ (if lp => "18446744073709551615UL" else "4294967295U") ++ "\n"
	++ "#define __SIZE_TYPE__ " ++ (if lp => "unsigned long" else "unsigned int") ++ "\n"
	++ "#define __PTRDIFF_TYPE__ " ++ (if lp => "long" else "int") ++ "\n"
	++ "#define __INTPTR_TYPE__ " ++ (if lp => "long" else "int") ++ "\n"
	++ "#define __UINTPTR_TYPE__ " ++ (if lp => "unsigned long" else "unsigned int") ++ "\n"
	++ "#define __INTMAX_TYPE__ long long\n"
	++ "#define __UINTMAX_TYPE__ unsigned long long\n"
	++ "#define __WCHAR_TYPE__ int\n"
	++ "#define __CHAR16_TYPE__ unsigned short\n"
	++ "#define __CHAR32_TYPE__ unsigned int\n"
	++ "#define __ORDER_LITTLE_ENDIAN__ 1234\n"
	++ "#define __ORDER_BIG_ENDIAN__ 4321\n"
	++ "#define __BYTE_ORDER__ __ORDER_LITTLE_ENDIAN__\n"
	++ "#define __FLT_MAX__ 3.40282347e+38F\n"
	++ "#define __DBL_MAX__ 1.7976931348623157e+308\n"
	++ "#define __FUNCTION__ __func__\n"
	++ "#define __PRETTY_FUNCTION__ __func__\n"
	++ "#define __extension__\n"
	++ "#define __restrict restrict\n"
	++ "#define __restrict__ restrict\n"
	++ "#define __inline inline\n"
	++ "#define __inline__ inline\n"
	++ "#define __const const\n"
	++ "#define __volatile__ volatile\n"
	++ "#define __signed__ signed\n"
	++ "#define __alignof__ _Alignof\n"
	++ "#define __typeof__ typeof\n"
	++ "#define __asm__ asm\n"
