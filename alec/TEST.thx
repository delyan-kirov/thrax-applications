$ @mod TEST

# \file TEST.thx
# \info The differential test suite. Every `tests/run/NAME.c` is a C program
#       whose expected behaviour is what gcc makes of it: its stdout and exit
#       status, recorded in `NAME.expected` (and fed `NAME.input` on stdin when
#       that exists). Each program is compiled by alec for wasm32 and wasm64,
#       run under node, and compared.
#           thrax run TEST.thx                   run every test
#           thrax run TEST.thx -- NAME...        run some
#           thrax run TEST.thx -- --regen        re-record the expectations with gcc
#           thrax run TEST.thx -- --suite DIR    an external suite in the c-testsuite
#                                                layout: DIR/NAME.c, DIR/NAME.c.expected
#                                                (stdout), exit status 0
#       The C library comes from alec's cache (parsed once per target if the
#       cache is out of date) and is shared by all the tests.

$ with IO
$ with STR
$ with OPT
$ with VEC
$ with SET
$ with MAP
$ with LEX
$ with DIAG
$ with PP
$ with CFG
$ with TYPE
$ with AST
$ with PARSE
$ with LINK
$ with DRIVER

$ scratch : @str = "tests/out"

$ Outcome : @union = Pass : {}, Fail : { @str },

# Compile `units` linked with the library units, catching a diagnostic as the
# test's failure instead of ending the run.
$ build : Opts -> @vec TU -> @str -> <Files, @io> Result @str @str = \o lib path =
	do
		let user = parse_from Opts.{ .files = [path] | o } 0 (@vec_len lib) (@vec_new {}) in
		Result.Ok.{ link o.target "_start" (VEC.append lib user) }
	ctl k
	   | Diag.fail e => Result.Err.{ render "error" e }
	   | Diag.warn e => k {}

$ sh_quote : @str -> @str = \s = "'" ++ replace s "'" "'\\''" ++ "'"

# Run a command, returning its combined output and exit status in the
# expectation format.
# `tag` names the capture file, so concurrent runs do not share one.
$ capture : @str -> @str -> @str -> <@io> @str = \tag cmd input =
	let out = scratch ++ "/" ++ tag ++ ".out" in
	let stdin = if is_some (read_file input) => " < " ++ sh_quote input else " < /dev/null" in
	let status = C.system ("(" ++ cmd ++ ")" ++ stdin ++ " > " ++ sh_quote out ++ " 2>/dev/null; echo exit=$? >> " ++ sh_quote out) in
	unwrap_or (read_file out) ("exit=" ++ to_string status ++ "\n")

# Where a suite's programs live and how their expectations are stored.
$ Suite : @struct = dir : @str, suffix : @str, status : @bool,

$ own : Suite = Suite.{ .dir = "tests/run", .suffix = ".expected", .status = @true }

$ source_of : Suite -> @str -> @str = \su t = su.dir ++ "/" ++ t ++ ".c"

$ expected_of : Suite -> @str -> <@io> @str = \su t =
	let e = unwrap_or (read_file (su.dir ++ "/" ++ t ++ (if su.status => ".expected" else ".c.expected"))) "" in
	if su.status => e else e ++ "exit=0\n"

$ regen : @str -> <@io> {} = \t =
	let src = "tests/run/" ++ t ++ ".c",
	    bin = scratch ++ "/" ++ t ++ ".gcc" in
	let cc = C.system ("gcc -std=gnu11 -w -O0 -o " ++ sh_quote bin ++ " " ++ sh_quote src ++ " -lm") in
	if cc != 0 => eprintln ("  " ++ t ++ ": gcc could not compile it")
	else
		let r = capture (t ++ ".gcc") (sh_quote bin) ("tests/run/" ++ t ++ ".input") in
		write_file ("tests/run/" ++ t ++ ".expected") r;
		println ("  recorded " ++ t)

$ run_one : Suite -> Opts -> @vec TU -> @str -> <Files, @io> Outcome = \su o lib t =
	let src = source_of su t,
	    wasm = scratch ++ "/" ++ t ++ "." ++ o.target.name ++ ".wasm" in
	is build o lib src
	| Result.Err.{ msg } => Outcome.Fail.{ msg }
	| Result.Ok.{ bytes } =>
		write_file wasm bytes;
		let got = capture (t ++ "." ++ o.target.name) ("node run.mjs " ++ sh_quote wasm) (su.dir ++ "/" ++ t ++ ".input") in
		let want = expected_of su t in
		if got == want => Outcome.Pass
		else Outcome.Fail.{ "output differs\n--- expected\n" ++ want ++ "--- got\n" ++ got }

$ run_target : Suite -> Opts -> @vec @str -> <@io> {Set @str, @int} = \su o tests =
	let r = do (let lib = VEC.map (\unit = unit {}) (MAP.values (library o)) in
			with_files (file_state o) (\u = run_all su o lib tests 0 SET.new_str 0))
		ctl k
		   | Diag.fail e => (eprintln ("C library: " ++ render "error" e); {SET.new_str, 0})
		   | Diag.warn e => k {} in
	r

$ run_all : Suite -> Opts -> @vec TU -> @vec @str -> @int -> Set @str -> @int -> <Files, Diag, @io> {Set @str, @int} = \su o lib tests i failed passed =
	if i >= @vec_len tests => {failed, passed}
	else
		let t = @vec_get tests i in
		is run_one su o lib t
		| Outcome.Pass => (println ("  ok    " ++ o.target.name ++ " " ++ t); run_all su o lib tests (i + 1) failed (passed + 1))
		| Outcome.Fail.{ why } =>
			println ("  FAIL  " ++ o.target.name ++ " " ++ t ++ "\n" ++ indent why);
			run_all su o lib tests (i + 1) (SET.add failed (o.target.name ++ " " ++ t)) passed

$ indent : @str -> @str = \s = join "\n" (VEC.map (\l = "        " ++ l) (lines s))

$ all_tests : Suite -> <@io> @vec @str = \su =
	VEC.map (\n = substr n 0 (STR.len n - 2)) (VEC.filter (\n = ends_with n ".c") (read_dir su.dir))

$ @main : @vec @str -> <@io> @int = \args =
	C.system ("mkdir -p " ++ scratch);
	let rest = @vec_slice args 1 (@vec_len args) in
	let si = VEC.find_index (\a = a == "--suite") rest in
	let su = (is si | Option.Some.{ i } => Suite.{ .dir = @vec_get rest (i + 1), .suffix = ".c.expected", .status = @false } | _ => own) in
	let named = VEC.filter (\a = a != "--regen" && a != "--suite" && a != su.dir) rest in
	let tests = if @vec_len named > 0 => named else all_tests su in
	if VEC.any (\a = a == "--regen") args =>
		(println "recording expectations with gcc:"; for tests (\t = regen t); 0)
	else
		let home = DRIVER.find_home (@vec_get args 0) in
		let o = Opts.{ .target = wasm32, .out = "", .mode = Mode.Compile, .files = @vec_new {},
			.incs = @vec_new {}, .defs = "", .stdlib = @true, .home = home, .dump = @false, .verbose = @false, .quiet = @true } in
		println ("alec tests: " ++ to_string (@vec_len tests) ++ " programs from " ++ su.dir ++ ", wasm32 and wasm64");
		let r32 = run_target su o tests in
		let r64 = run_target su Opts.{ .target = wasm64 | o } tests in
		let failed = SET.merge r32.0 r64.0 in
		let passed = r32.1 + r64.1 in
		println ("\n" ++ to_string passed ++ " passed, " ++ to_string (SET.size failed) ++ " failed");
		for (SET.to_list failed) (\f = println ("  failed: " ++ f));
		if SET.size failed == 0 => 0 else 1
