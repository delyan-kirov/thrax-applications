$ @mod LINK

# \file LINK.thx
# \info The linker: translation units in, one WebAssembly module out. alec
#       compiles every input (and its C library) in one run, so linking is a
#       pass over typed trees rather than object files:
#         1. merge the units' functions, globals and prototypes, checking for
#            multiple definitions;
#         2. keep what is reachable from the entry point, so the C library
#            costs only what a program uses;
#         3. functions declared but defined nowhere become imports from the
#            host's `env` module (that is the FFI: a C prototype is enough);
#         4. lay out the data, then the shadow stack, then the heap;
#         5. generate each function and assemble the module.

$ with LEX
$ with DIAG
$ with TYPE
$ with AST
$ with CFG
$ with WASM
$ with GEN
$ with PARSE
$ with OPT
$ with MAP
$ with SET
$ with BITS
$ with LIST
$ with VEC
$ with STR

$ stack_size : @int = 1048576
$ data_base : @int = 1024

# The C library's entry point calls this, and the linker writes it: it calls
# `main` with whichever parameters `main` was declared to take.
$ main_shim : @str = "__alec_main"

$ link : Target -> @str -> @vec TU -> <Diag> @str = \tg entry tus =
	let lay = Layout.{ .target = tg, .aggs = merge_aggs tus } in
	let funcs = collect_funcs tus 0 0 MAP.new_str in
	let globals = collect_globals tus 0 0 MAP.new_str in
	let protos = VEC.foldl (\m tu = MAP.fold (\acc k v = if MAP.has acc k => acc else MAP.insert acc k v) m tu.protos) MAP.new_str tus in
	(if !(MAP.has funcs entry) => error_at nowhere ("undefined reference to '" ++ entry ++ "' (the entry point)") else {});
	let frefs = VEC.foldl (\m tu = VEC.foldl (\m2 f = MAP.insert m2 f.name (func_refs tu f)) m tu.funcs) MAP.new_str tus in
	let live = reach frefs globals (LIST.singleton entry) SET.new_str in
	let defined = VEC.filter (\f = SET.has live f.name) (MAP.values funcs) in
	let ordered = VEC.sort_by (\a b = STR.cmp_str a.name b.name) defined in
	let imports = VEC.filter (\n = !(MAP.has funcs n) && !(MAP.has globals n) && is_none (GEN.intrinsic n) && n != main_shim && n != "__heap_base" && n != "alloca")
		(SET.to_list live) in
	let shim = SET.has live main_shim in
	check_vars imports protos;
	let gvars = VEC.filter (\g = SET.has live g.name) (MAP.values globals) in
	let placed = place lay gvars 0 data_base MAP.new_str (@vec_new {}) in
	let data_end = placed.0 in
	let stack_top = align_to (data_end + stack_size) 16 in
	let addrs = MAP.insert placed.1 "__heap_base" stack_top in
	let ni = @vec_len imports in
	let fidx0 = VEC.foldl (\m n = MAP.insert m n (MAP.size m)) MAP.new_str imports in
	let fidx1 = VEC.foldl (\m f = MAP.insert m f.name (MAP.size m)) fidx0 ordered in
	let fidx = if shim => MAP.insert fidx1 main_shim (MAP.size fidx1) else fidx1 in
	let table_names = VEC.append imports (VEC.map (\f = f.name) ordered) in
	let tidx = VEC.foldl (\m n = MAP.insert m n (MAP.size m + 1)) MAP.new_str table_names in
	let ftys0 = MAP.fold (\m k t = is fn_of t | Option.Some.{ ft } => MAP.insert m k ft | _ => m) MAP.new_str protos in
	let ftys = VEC.foldl (\m f = MAP.insert m f.name f.ty) ftys0 ordered in
	let ctx = Ctx.{ .lay = lay, .tg = tg, .addrs = addrs, .fidx = fidx, .tidx = tidx, .ftys = ftys, .heap = stack_top } in
	let imp = VEC.foldl (\acc n =
		let ft = unwrap_or (MAP.get ftys n) (FnTy.{ .ret = t_int, .params = List.Nil, .variadic = @false, .proto = @false }) in
		let r = type_index acc.1 (sig_of tg ft) in
		{@vec_push acc.0 Import.{ .module = "env", .name = n, .type = r.0 }, r.1}) {@vec_new {}, empty_types} imports in
	let gen = gen_all ctx ordered 0 (@vec_new {}) (@vec_new {}) imp.1 in
	let with_shim = if shim => add_shim ctx ftys gen else gen in
	let pages = (stack_top + 65536 + 65535) / 65536 in
	let m = Module.{
		.types = with_shim.2.sigs,
		.imports = imp.0,
		.funcs = with_shim.1,
		.table = VEC.map (\n = unwrap_or (MAP.get fidx n) 0) table_names,
		.pages = pages,
		.mem64 = tg.wasm64,
		.globals = [Global.{ .vt = ptr_vt tg, .mutable = @true, .init = (if tg.wasm64 => i64_const stack_top else i32_const stack_top) }],
		.exports = [Export.{ .name = "memory", .kind = 2, .index = 0 },
			Export.{ .name = entry, .kind = 0, .index = unwrap_or (MAP.get fidx entry) 0 }],
		.bodies = with_shim.0,
		.data = VEC.filter_map (\g = data_of ctx g) gvars,
		.names = VEC.append table_names (if shim => [main_shim] else @vec_new {}) } in
	encode m

# The names a set of units uses but none of them defines: what is still to
# be found in the C library (or left to the host as imports).
$ undefined : @vec TU -> Set @str = \tus =
	let defined = VEC.foldl (\acc tu =
		VEC.foldl (\a g = if g.defined || g.init => SET.add a g.name else a)
			(VEC.foldl (\a f = SET.add a f.name) acc tu.funcs) tu.globals) SET.new_str tus in
	let used = VEC.foldl (\acc tu =
		VEC.foldl (\a g = VEC.foldl (\b r = SET.add b r.sym) a g.relocs)
			(VEC.foldl (\a f = LIST.foldl (\b n = SET.add b n) a (func_refs tu f)) acc tu.funcs) tu.globals) SET.new_str tus in
	SET.filter (\n = !(SET.has defined n)) used

# The names `f`'s body refers to.
$ func_refs : TU -> Func -> List @str = \tu f =
	is MAP.get tu.refs f.name | Option.Some.{ r } => r | _ => refs_stmt f.body List.Nil

# The externally visible names a unit defines, for the library index.
$ exports : TU -> @vec @str = \tu =
	VEC.append (VEC.filter_map (\f = if f.static => Option.None else Option.Some.{ f.name }) tu.funcs)
		(VEC.filter_map (\g = if g.static || !(g.defined || g.init) => Option.None else Option.Some.{ g.name }) tu.globals)

$ @private

# Each unit numbers its aggregates from its own base (see PARSE.with_tab), so
# their tables merge into one without collisions.
$ merge_aggs : @vec TU -> Map @int Agg = \tus = merge_aggs_go tus 0 MAP.new_int

$ merge_aggs_go : @vec TU -> @int -> Map @int Agg -> Map @int Agg = \tus i acc =
	if i >= @vec_len tus => acc
	else merge_aggs_go tus (i + 1) (MAP.fold (\m k v = MAP.insert m k v) acc (@vec_get tus i).layout.aggs)

$ collect_funcs : @vec TU -> @int -> @int -> Map @str Func -> <Diag> Map @str Func = \tus i j acc =
	if i >= @vec_len tus => acc
	else
		let fs = (@vec_get tus i).funcs in
		if j >= @vec_len fs => collect_funcs tus (i + 1) 0 acc
		else
			let f = @vec_get fs j in
			if MAP.has acc f.name => error_at f.pos ("multiple definition of '" ++ f.name ++ "'")
			else collect_funcs tus i (j + 1) (MAP.insert acc f.name f)

$ collect_globals : @vec TU -> @int -> @int -> Map @str GVar -> <Diag> Map @str GVar = \tus i j acc =
	if i >= @vec_len tus => acc
	else
		let gs = (@vec_get tus i).globals in
		if j >= @vec_len gs => collect_globals tus (i + 1) 0 acc
		else
			let g = @vec_get gs j in
			let merged = (is MAP.get acc g.name
				| Option.Some.{ old } =>
					if old.init && g.init => error_at g.pos ("multiple definition of '" ++ g.name ++ "'")
					else if g.init => g
					else if old.init => old
					else if g.defined && !old.defined => g
					else if array_len old.ty < 0 && array_len g.ty >= 0 => GVar.{ .ty = g.ty | old }
					else old
				| _ => g) in
			collect_globals tus i (j + 1) (MAP.insert acc g.name merged)

# A variable used but defined nowhere has no import to become.
$ check_vars : @vec @str -> Map @str Ty -> <Diag> {} = \names protos =
	for names (\n =
		if MAP.has protos n => {} else error_at nowhere ("undefined reference to '" ++ n ++ "'"))

# -- reachability -------------------------------------------------------------------

$ reach : Map @str (List @str) -> Map @str GVar -> List @str -> Set @str -> Set @str = \frefs globals work seen =
	is work
	| List.Nil => seen
	| List.Cons.{ n, rest } =>
		if SET.has seen n => reach frefs globals rest seen
		else
			let seen2 = SET.add seen n in
			let more =
				(is MAP.get frefs n
				 | Option.Some.{ r } => r
				 | _ =>
					(is MAP.get globals n
					 | Option.Some.{ g } => VEC.foldl (\acc r = List.Cons.{ r.sym, acc }) List.Nil g.relocs
					 | _ => if n == main_shim => LIST.singleton "main" else List.Nil)) in
			reach frefs globals (LIST.append more rest) seen2

$ refs_stmt : Stmt -> List @str -> List @str = \s acc =
	is s
	| Stmt.Do.{ e } => refs e acc
	| Stmt.Block.{ ss } => LIST.foldl (\a x = refs_stmt x a) acc ss
	| Stmt.If.{ c, a, b } => refs_stmt b (refs_stmt a (refs c acc))
	| Stmt.While.{ c, b } => refs_stmt b (refs c acc)
	| Stmt.DoWhile.{ b, c } => refs c (refs_stmt b acc)
	| Stmt.For.{ i, c, st, b } => refs_stmt b (refs st (refs c (refs_stmt i acc)))
	| Stmt.Switch.{ e, b } => refs_stmt b (refs e acc)
	| Stmt.Case.{ lo, hi, b } => refs_stmt b acc
	| Stmt.Default.{ b } => refs_stmt b acc
	| Stmt.Label.{ l, b } => refs_stmt b acc
	| Stmt.Return.{ e } => refs e acc
	| Stmt.Jump.{ e, cs, d } => refs e acc
	| Stmt.GotoPtr.{ e } => refs e acc
	| _ => acc

$ refs : Expr -> List @str -> List @str = \e acc =
	is e.e
	| ENode.Global.{ g } => List.Cons.{ g, acc }
	| ENode.Unary.{ o, x } => refs x acc
	| ENode.Bin.{ o, a, b } => refs b (refs a acc)
	| ENode.Assign.{ a, b } => refs b (refs a acc)
	| ENode.OpAssign.{ o, a, b, t } => refs b (refs a acc)
	| ENode.PostOp.{ o, a, b } => refs b (refs a acc)
	| ENode.Cond.{ c, a, b } => refs b (refs a (refs c acc))
	| ENode.Comma.{ a, b } => refs b (refs a acc)
	| ENode.Call.{ f, args, ft } => LIST.foldl (\a x = refs x a) (refs f acc) args
	| ENode.Field.{ x, m } => refs x acc
	| ENode.Deref.{ x } => refs x acc
	| ENode.Addr.{ x } => refs x acc
	| ENode.Cast.{ x } => refs x acc
	| ENode.Zero.{ x, n } => refs x acc
	| ENode.Copy.{ a, b, n } => refs b (refs a acc)
	| ENode.Alloca.{ x } => refs x acc
	| ENode.VaStart.{ x } => refs x acc
	| ENode.VaArg.{ x } => refs x acc
	| ENode.SExpr.{ ss, x } => refs x (LIST.foldl (\a s = refs_stmt s a) acc ss)
	| _ => acc

# -- data layout ----------------------------------------------------------------------

$ place : Layout -> @vec GVar -> @int -> @int -> Map @str @int -> @vec GVar -> {@int, Map @str @int} = \lay gs i at addrs acc =
	if i >= @vec_len gs => {at, addrs}
	else
		let g = @vec_get gs i in
		let al = if g.align > 0 => g.align else (let a = align_of lay g.ty in if a < 1 => 1 else a) in
		let sz0 = size_of lay g.ty in
		let sz = if g.init && @array_len g.data > sz0 => @array_len g.data else sz0 in
		let start = align_to at al in
		place lay gs (i + 1) (start + (if sz < 1 => 1 else sz)) (MAP.insert addrs g.name start) acc

$ data_of : Ctx -> GVar -> Option Data = \c g =
	if !g.init => Option.None
	else
		let base = unwrap_or (MAP.get c.addrs g.name) 0 in
		let bytes = VEC.foldl (\b r =
			let v = (is MAP.get c.addrs r.sym | Option.Some.{ a } => a | _ => unwrap_or (MAP.get c.tidx r.sym) 0) + r.addend in
			patch b r.offset c.tg.ptr v) g.data g.relocs in
		if all_zero bytes 0 => Option.None else Option.Some.{ Data.{ .offset = base, .bytes = bytes } }

$ patch : @str -> @int -> @int -> @int -> @str = \b off n v =
	if n <= 0 => b else patch (@array_set b off (band v 255)) (off + 1) (n - 1) (shr_u v 8)

$ all_zero : @str -> @int -> @bool = \b i =
	if i >= @array_len b => @true else if @array_get b i != 0 => @false else all_zero b (i + 1)

# -- functions --------------------------------------------------------------------------

$ gen_all : Ctx -> @vec Func -> @int -> @vec Body -> @vec @int -> TypeTab -> <Diag> {@vec Body, @vec @int, TypeTab} =
	\c fs i bodies types tt =
	if i >= @vec_len fs => {bodies, types, tt}
	else
		let f = @vec_get fs i in
		let r = gen_func c f tt in
		let t = type_index r.1 (sig_of c.tg f.ty) in
		gen_all c fs (i + 1) (@vec_push bodies r.0) (@vec_push types t.0) t.1

# `__alec_main(argc, argv)` calls `main` with what it declares: nothing,
# `argc`, or `argc` and `argv`.
$ add_shim : Ctx -> Map @str FnTy -> {@vec Body, @vec @int, TypeTab} -> <Diag> {@vec Body, @vec @int, TypeTab} = \c ftys g =
	let mt = unwrap_or (MAP.get ftys "main") (FnTy.{ .ret = t_int, .params = List.Nil, .variadic = @false, .proto = @true }) in
	let np = LIST.length mt.params in
	let argc_ty = unwrap_or (LIST.head mt.params) t_int in
	let argc = local_get 0 ++ (is vt_of c.tg argc_ty | ValT.I64 => op 172 | _ => "") in
	let args = (if np >= 1 => argc else "") ++ (if np >= 2 => local_get 1 else "")
		++ (if np >= 3 => (if c.tg.wasm64 => i64_const 0 else i32_const 0) else "") in
	let ret = if is_void mt.ret => i32_const 0
		else (is vt_of c.tg mt.ret | ValT.I64 => op 167 | _ => "") in
	let code = args ++ call_op (unwrap_or (MAP.get c.fidx "main") 0) ++ ret in
	let sig = Sig.{ .params = [ValT.I32, ptr_vt c.tg], .results = [ValT.I32] } in
	let t = type_index g.2 sig in
	{@vec_push g.0 Body.{ .locals = @vec_new {}, .code = code }, @vec_push g.1 t.0, t.1}
