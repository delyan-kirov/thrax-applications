$ @mod AST

# \file AST.thx
# \info The typed syntax tree the parser produces and the code generator
#       consumes. Every expression carries its C type, already decided: the
#       parser applies the conversions as it builds (array and function decay,
#       the usual arithmetic conversions, pointer arithmetic scaled to bytes), so
#       the code generator never reasons about C typing rules.
#
#       Expressions and statements are recursive, so their slots are lazy and
#       their collections are `List`s.

$ with LEX
$ with TYPE

$ Expr : @struct = e : ENode, ty : Ty, pos : Pos,

$ ENode : @union =
	IntC : { @int },
	FltC : { @float64 },
	Local : { @int },
	Global : { @str },
	Unary : { @str, Expr },
	Bin : { @str, Expr, Expr },
	Assign : { Expr, Expr },
	OpAssign : { @str, Expr, Expr, Ty },
	PostOp : { @str, Expr, Expr },
	Cond : { Expr, Expr, Expr },
	Comma : { Expr, Expr },
	Call : { Expr, List Expr, FnTy },
	Field : { Expr, Member },
	Deref : { Expr },
	Addr : { Expr },
	Cast : { Expr },
	Zero : { Expr, @int },
	Copy : { Expr, Expr, @int },
	Alloca : { Expr },
	VaStart : { Expr },
	VaArg : { Expr },
	SExpr : { List Stmt, Expr },
	LabelAddr : { @str },
	Nop : {},

$ Stmt : @union =
	Do : { Expr },
	Block : { List Stmt },
	If : { Expr, Stmt, Stmt },
	While : { Expr, Stmt },
	DoWhile : { Stmt, Expr },
	For : { Stmt, Expr, Expr, Stmt },
	Switch : { Expr, Stmt },
	Case : { @int, @int, Stmt },
	Default : { Stmt },
	Break : {},
	Continue : {},
	Goto : { @str },
	Label : { @str, Stmt },
	Return : { Expr },
	Empty : {},
	Jump : { Expr, List {@int, @int, @str}, @str },
	GotoPtr : { Expr },

# A local variable. `mem` says it must live in the frame (its address is taken,
# or it is an array, struct or union); everything else becomes a wasm local.
$ LVar : @struct = id : @int, name : @str, ty : Ty, mem : @bool, align : @int,

$ Func : @struct =
	name : @str,
	ty : FnTy,
	params : List @int,
	locals : List LVar,
	body : Stmt,
	static : @bool,
	va : @int,
	pos : Pos,

# A relocation in a global's initial bytes: at `offset` goes the address of
# `sym` plus `addend` (for a function, its table index).
$ Reloc : @struct = offset : @int, sym : @str, addend : @int,

$ GVar : @struct =
	name : @str,
	ty : Ty,
	data : @str,
	relocs : @vec Reloc,
	defined : @bool,
	init : @bool,
	static : @bool,
	tls : @bool,
	align : @int,
	pos : Pos,

$ mk_expr : ENode -> Ty -> Pos -> Expr = \e t p = Expr.{ .e = e, .ty = t, .pos = p }

$ int_expr : @int -> Ty -> Pos -> Expr = \v t p = mk_expr ENode.IntC.{ v } t p

# A copy with another type or position. These read every field rather than
# using a record update: an expression taken out of a node's lazy slot may still
# be an unforced thunk, and a field read forces it where a record update does
# not (issue #310).
$ with_ty : Expr -> Ty -> Expr = \x t = Expr.{ .e = x.e, .ty = t, .pos = x.pos }
$ with_pos : Expr -> Pos -> Expr = \x p = Expr.{ .e = x.e, .ty = x.ty, .pos = p }

$ nop : Pos -> Expr = \p = mk_expr ENode.Nop TYPE.t_void p

# `n` zero bytes.
$ zeros : @int -> @str = \n = zeros_onto "" n

$ zeros_onto : @str -> @int -> @str = \acc n = if n <= 0 => acc else zeros_onto (@array_push acc 0) (n - 1)
