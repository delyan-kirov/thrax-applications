$ @mod DRIVER

# \file DRIVER.thx
# \info The alec driver: command line, the handlers that give the pipeline its
#       world (files, the macro table, diagnostics), and the output. Every
#       stage is written against effects; this module is the one place that
#       decides what those effects mean. MAIN is its command-line entry and
#       TEST reuses it in-process.

$ with IO
$ with STR
$ with OPT
$ with VEC
$ with SET
$ with MAP
$ with LEX
$ with DIAG
$ with PP
$ with CFG
$ with TYPE
$ with AST
$ with PARSE
$ with DUMP
$ with LINK
$ with CACHE
$ with WAT
$ with LIST

$ usage : @str =
	"usage: alec [options] file.c...\n"
	++ "\n"
	++ "Compiles C to a WebAssembly module (one module for all the files given,\n"
	++ "linked with alec's own C library).\n"
	++ "\n"
	++ "options:\n"
	++ "  --target wasm32|wasm64  memory model (default wasm32); also -m32, -m64\n"
	++ "  -w                      suppress warnings\n"
	++ "  -v                      report the library files loaded and the time each phase took\n"
	++ "  -o FILE                 output file (default a.wasm; -E writes to stdout)\n"
	++ "  -E                      preprocess only\n"
	++ "  -fsyntax-only           parse and type-check only\n"
	++ "  --dump-tokens           print the tokens of each file, as lexed\n"
	++ "  --dump-tokens=pp        print the tokens the parser sees, after preprocessing\n"
	++ "  --dump-ast              print the typed syntax tree\n"
	++ "  --dump-wasm             print the module as text (or that of each .wasm given)\n"
	++ "  --shell                 an interactive C shell (see :help in it)\n"
	++ "  -I DIR                  add DIR to the include search path\n"
	++ "  -D NAME[=VALUE]         define a macro\n"
	++ "  -U NAME                 undefine a macro\n"
	++ "  -nostdlib               do not link alec's C library\n"
	++ "  --index-libc            rebuild libc/INDEX and the library caches\n"
	++ "  -h, --help              show this help\n"

$ Mode : @union = Compile: {}, Preprocess: {}, Syntax: {}, Help: {}, Index: {}, Tokens: { @bool }, Wasm: {}, Shell: {},

$ Opts : @struct =
	target : Target,
	out : @str,
	mode : Mode,
	files : @vec @str,
	incs : @vec @str,
	defs : @str,
	stdlib : @bool,
	home : @str,
	dump : @bool,
	verbose : @bool,
	quiet : @bool,

$ parse_args : @vec @str -> @int -> Opts -> Result Opts @str = \a i o =
	if i >= @vec_len a => Result.Ok.{ o }
	else
		let s = @vec_get a i,
		    next = if i + 1 < @vec_len a => @vec_get a (i + 1) else "" in
		if s == "-h" || s == "--help" => Result.Ok.{ Opts.{ .mode = Mode.Help | o } }
		else if s == "--target=wasm32" || s == "-m32" => parse_args a (i + 1) Opts.{ .target = wasm32 | o }
		else if s == "--target=wasm64" || s == "-m64" => parse_args a (i + 1) Opts.{ .target = wasm64 | o }
		else if s == "--target" || s == "-target" =>
			(if next == "wasm32" => parse_args a (i + 2) Opts.{ .target = wasm32 | o }
			 else if next == "wasm64" => parse_args a (i + 2) Opts.{ .target = wasm64 | o }
			 else Result.Err.{ "unknown target `" ++ next ++ "` (expected wasm32 or wasm64)" })
		else if starts_with s "--target=" => Result.Err.{ "unknown target `" ++ substr s 9 (STR.len s) ++ "` (expected wasm32 or wasm64)" }
		else if s == "-E" => parse_args a (i + 1) Opts.{ .mode = Mode.Preprocess | o }
		else if s == "-fsyntax-only" => parse_args a (i + 1) Opts.{ .mode = Mode.Syntax | o }
		else if s == "-v" => parse_args a (i + 1) Opts.{ .verbose = @true | o }
		else if s == "-w" => parse_args a (i + 1) Opts.{ .quiet = @true | o }
		else if s == "--index-libc" => Result.Ok.{ Opts.{ .mode = Mode.Index | o } }
		else if s == "--dump-ast" => parse_args a (i + 1) Opts.{ .dump = @true, .mode = Mode.Syntax | o }
		else if s == "--dump-tokens" => parse_args a (i + 1) Opts.{ .mode = Mode.Tokens.{ @false } | o }
		else if s == "--dump-tokens=pp" => parse_args a (i + 1) Opts.{ .mode = Mode.Tokens.{ @true } | o }
		else if s == "--dump-wasm" => parse_args a (i + 1) Opts.{ .mode = Mode.Wasm | o }
		else if s == "--shell" => parse_args a (i + 1) Opts.{ .mode = Mode.Shell | o }
		else if s == "-nostdlib" => parse_args a (i + 1) Opts.{ .stdlib = @false | o }
		else if s == "-o" => parse_args a (i + 2) Opts.{ .out = next | o }
		else if s == "-I" => parse_args a (i + 2) Opts.{ .incs = @vec_push o.incs next | o }
		else if starts_with s "-I" => parse_args a (i + 1) Opts.{ .incs = @vec_push o.incs (substr s 2 (STR.len s)) | o }
		else if s == "-D" => parse_args a (i + 2) Opts.{ .defs = o.defs ++ define_line next | o }
		else if starts_with s "-D" => parse_args a (i + 1) Opts.{ .defs = o.defs ++ define_line (substr s 2 (STR.len s)) | o }
		else if s == "-U" => parse_args a (i + 2) Opts.{ .defs = o.defs ++ "#undef " ++ next ++ "\n" | o }
		else if starts_with s "-U" => parse_args a (i + 1) Opts.{ .defs = o.defs ++ "#undef " ++ substr s 2 (STR.len s) ++ "\n" | o }
		else if starts_with s "-" && s != "-" => Result.Err.{ "unknown option `" ++ s ++ "`" }
		else parse_args a (i + 1) Opts.{ .files = @vec_push o.files s | o }

# `-D NAME=VALUE` is `#define NAME VALUE`; a bare `-D NAME` defines it as 1.
$ define_line : @str -> @str = \s =
	is STR.find s "="
	| Option.Some.{ i } => "#define " ++ substr s 0 i ++ " " ++ substr s (i + 1) (STR.len s) ++ "\n"
	| _ => "#define " ++ s ++ " 1\n"

$ dirname : @str -> @str = \p =
	is last_slash p (STR.len p - 1) | Option.Some.{ i } => (if i == 0 => "/" else substr p 0 i) | _ => "."

# alec's own `include` and `libc` sit beside MAIN.thx. Under `thrax run` that is
# argv[0]'s directory; a compiled binary lands one level down, in `thrax-out/`.
$ find_home : @str -> <@io> @str = \argv0 =
	let dir = dirname argv0 in
	is read_file (dir ++ "/include/stddef.h") | Option.Some.{ _ } => dir | _ => dir ++ "/.."

$ last_slash : @str -> @int -> Option @int = \p i =
	if i < 0 => Option.None else if at p i == 47 => Option.Some.{ i } else last_slash p (i - 1)

# -- the world the preprocessor sees ----------------------------------------

$ FileState : @struct = once : Set @str, incs : @vec @str, sys : @str,

# Directory search for an include: a quoted name looks beside the including file
# first; both forms then try each `-I` directory and finally alec's own headers.
$ candidates : FileState -> Request -> @vec @str = \st r =
	if starts_with r.name "/" => [r.name]
	else
		let dirs = (if r.angled => [] else [r.dir]) ++ st.incs ++ [st.sys] in
		VEC.map (\d = normalize (d ++ "/" ++ r.name)) dirs

# Collapse `./` and `dir/../` so the same file reached two ways has one name,
# which is what makes `#pragma once` reliable.
$ normalize : @str -> @str = \p =
	let parts = VEC.filter (\s = s != "" && s != ".") (split p "/") in
	let kept = VEC.foldl (\acc s = if s == ".." && @vec_len acc > 0 && @vec_get acc (@vec_len acc - 1) != ".."
		=> @vec_slice acc 0 (@vec_len acc - 1) else @vec_push acc s) (@vec_new {}) parts in
	(if starts_with p "/" => "/" else "") ++ join "/" kept

$ first_file : @vec @str -> @int -> @str -> <@io> Option {@str, @str} = \cs i skip =
	if i >= @vec_len cs => Option.None
	else
		let path = @vec_get cs i in
		if path == skip => first_file cs (i + 1) skip
		else is read_file path
			| Option.Some.{ src } => Option.Some.{ {path, src} }
			| _ => first_file cs (i + 1) skip

$ with_files : FileState -> ({} -> <Files, Diag, @io> a) -> <Diag, @io> a = \st0 body =
	let go = do body {}
		ctl k
		   | Files.include r => \st =
				(is first_file (candidates st r) 0 (if r.next => normalize r.from else "")
				 | Option.Some.{ found } =>
					if SET.has st.once found.0 => (k Loaded.Skip) st
					else (k Loaded.Found.{ found.0, found.1 }) st
				 | _ => (k Loaded.Missing) st)
		   | Files.has_file r => \st = (k (is_some (first_file (candidates st r) 0 ""))) st
		   | Files.once path => \st = (k {}) FileState.{ .once = SET.add st.once (normalize path) | st }
		   | v => \st = v
	in go st0

# Diagnostics: a warning prints and resumes, an error prints and ends the run
# with exit status 1.
$ with_diag : Opts -> ({} -> <Diag, @io> @int) -> <@io> @int = \o body =
	do body {}
	ctl k
	   | Diag.fail e => (eprintln (render "error" e); 1)
	   | Diag.warn e => ((if o.quiet => {} else eprintln (render "warning" e)); k {})

# -- -E ---------------------------------------------------------------------

# The preprocessed text: a newline where a token began a source line, a space
# where it had space before it.
$ emit_text : ({} -> <Files, Out, Diag, @io> {}) -> <Files, Diag, @io> @str = \body =
	let go = do body {}; \acc = acc
		ctl k | Out.emit t => \acc = (k {}) (acc ++ (if t.bol && STR.len acc > 0 => "\n" else if t.space => " " else "") ++ t.text)
	in go ""

# Every token the preprocessor emits, in order.
$ collect_tokens : ({} -> <Files, Out, Diag, @io> {}) -> <Files, Diag, @io> List Token = \body =
	let go = do body {}; \acc = LIST.reverse acc
		ctl k | Out.emit t => \acc = (k {}) List.Cons.{ t, acc }
	in go List.Nil

$ main_tokens : Opts -> @bool -> <@io> @int = \o pp =
	with_diag o <| \u =
		with_files (file_state o) <| \u2 =
			for o.files (\f =
				if pp => for (collect_tokens (\u3 = with_macros initial_macros (\u4 = run_file o f))) (\t = println (DUMP.token t))
				else is read_file f
					| Option.Some.{ src } => for (lex f src) (\t = println (DUMP.token t))
					| _ => error_at nowhere (f ++ ": No such file or directory"));
			0

$ main_preprocess : Opts -> <@io> @int = \o =
	with_diag o <| \u =
		with_files (file_state o) <| \u2 =
			let text = emit_text (\u3 = for o.files (\f = with_macros initial_macros (\u4 = run_file o f))) in
			(if o.out == "a.wasm" || o.out == "-" => println text else (write_file o.out (text ++ "\n"); {}));
			0

# One translation unit: the predefined macros, then the file. The root is read
# through the same handler as its includes, so a missing root file reports the
# way a missing header does.
$ run_file : Opts -> @str -> <PPfx> {} = \o f =
	preprocess "<built-in>" (lex "<built-in>" (predefined o.target ++ o.defs));
	is Files.include Request.{ .name = f, .angled = @false, .dir = ".", .next = @false, .from = "" }
	| Loaded.Found.{ path, src } => preprocess path (lex path src)
	| _ => error_at nowhere (f ++ ": No such file or directory")

# Preprocess and parse every file, each its own translation unit, numbered
# from 1 (the number keeps their static names apart).
$ parse_all : Opts -> <Files, Diag, @io> @vec TU = \o = parse_from o 0 0 (@vec_new {})

# Units are numbered from 1 in parse order, `base` counting the ones before.
$ parse_from : Opts -> @int -> @int -> @vec TU -> <Files, Diag, @io> @vec TU = \o i base acc =
	if i >= @vec_len o.files => acc
	else
		let f = @vec_get o.files i in
		let pull = start (\u = with_macros initial_macros (\u2 = run_file o f)) in
		let tu = parse_tu o.target (base + i + 1) pull in
		parse_from o (i + 1) base (@vec_push acc tu)

$ main_syntax : Opts -> <@io> @int = \o =
	with_diag o <| \u =
		with_files (file_state o) <| \u2 =
			let tus = parse_all o in
			(if o.dump => for tus (\tu = print (DUMP.unit tu)) else {});
			0

# The C library is compiled with the program, from `libc/` beside alec, but
# only the files a program needs: `libc/INDEX` names the file that defines
# each library symbol, and a file joins the program once something undefined
# is in it. Every library file is parsed once and kept, per target, in a cache
# beside the sources (see CACHE), which is remade whenever anything it depends
# on changes. `alec --index-libc` rebuilds the index and both caches.
$ ms : @int -> @int -> @str = \a b = to_string ((b - a) / 1000) ++ " ms"

$ libc_dir : Opts -> @str = \o = o.home ++ "/libc"

$ read_index : Opts -> <@io> Map @str @str = \o =
	let text = unwrap_or (read_file (libc_dir o ++ "/INDEX")) "" in
	VEC.foldl (\m line = is STR.find line " " | Option.Some.{ i } => MAP.insert m (substr line 0 i) (substr line (i + 1) (STR.len line)) | _ => m)
		MAP.new_str (lines text)

$ main_compile : Opts -> <@io> @int = \o =
	let index = read_index o in
	with_diag o <| \u =
		let bytes = compile_with o (\v = library o) index in
		if write_file o.out bytes => 0
		else (eprintln ("alec: error: cannot write " ++ o.out); 1)

# Compile `o.files` into a module. `lib` is asked for the C library only when
# the program links it.
$ compile_with : Opts -> ({} -> <Diag, @io> Map @str ({} -> TU)) -> Map @str @str -> <Diag, @io> @str = \o lib index =
	let t0 = C.clock {} in
	let user = with_files (file_state o) (\u = parse_all o) in
	let t1 = C.clock {} in
	let tus = if o.stdlib => load_libc o (lib {}) index user SET.new_str else user in
	let t2 = C.clock {} in
	let bytes = link o.target (if o.stdlib => "_start" else "main") tus in
	let t3 = C.clock {} in
	(if o.verbose =>
		eprintln ("alec: parse " ++ ms t0 t1 ++ ", library " ++ ms t1 t2 ++ ", link and generate " ++ ms t2 t3
			++ ", " ++ to_string (STR.len bytes) ++ " bytes")
	 else {});
	bytes

# Compile and print the module as text; `.wasm` files given are printed as
# they are.
$ main_wasm : Opts -> <@io> @int = \o =
	if VEC.all (\f = ends_with f ".wasm") o.files =>
		(for o.files (\f =
			is read_file f
			| Option.Some.{ bytes } => for (WAT.module_lines bytes) (\l = println l)
			| _ => eprintln ("alec: error: " ++ f ++ ": No such file or directory"));
		 0)
	else
		with_diag o <| \u =
			for (WAT.module_lines (compile_with o (\v = library o) (read_index o))) (\l = println l);
			0

# Add library units until nothing undefined is found in the index; `crt.c`
# (the entry point) is always needed.
$ load_libc : Opts -> Map @str ({} -> TU) -> Map @str @str -> @vec TU -> Set @str -> <Diag, @io> @vec TU = \o lib index tus loaded =
	let missing = SET.add (undefined tus) "_start" in
	let files = SET.to_list (SET.fold (\acc sym = is MAP.get index sym | Option.Some.{ f } => if SET.has loaded f => acc else SET.add acc f | _ => acc) SET.new_str missing) in
	if @vec_len files == 0 => tus
	else
		(if o.verbose => eprintln ("alec: loading " ++ join " " files) else {});
		let more = VEC.foldl (\acc f = is MAP.get lib f | Option.Some.{ unit } => @vec_push acc (unit {}) | _ => acc) tus files in
		load_libc o lib index more (VEC.foldl (\s f = SET.add s f) loaded files)

# Library units are numbered from here, each file by its place in name order,
# so a unit is the same whether it was parsed now or read from the cache, and
# never collides with the program's own units (numbered from 1).
$ lib_base : @int = 1000

$ cache_path : Opts -> @str = \o = libc_dir o ++ "/" ++ o.target.name ++ ".cache"

# Every library file's unit for `o.target`, by file name, each produced when
# it is first needed.
$ library : Opts -> <Diag, @io> Map @str ({} -> TU) = \o =
	let st = CACHE.stamp o.home in
	let units = is CACHE.load (cache_path o) st o.target
		| Option.Some.{ cached } => cached
		| _ =>
			(if o.verbose => eprintln ("alec: parsing the C library for " ++ o.target.name) else {});
			let parsed = parse_library o in
			CACHE.save (cache_path o) st parsed;
			VEC.map (\u = {u.0, \v = u.1}) parsed in
	VEC.foldl (\m u = MAP.insert m u.0 u.1) MAP.new_str units

# The library is its own world: only alec's headers, and none of the command
# line's `-I`, `-D` or `-U`.
$ parse_library : Opts -> <Diag, @io> @vec {@str, TU} = \o =
	let files = VEC.filter (\n = ends_with n ".c") (read_dir (libc_dir o)) in
	let lo = Opts.{ .files = VEC.map (\f = libc_dir o ++ "/" ++ f) files, .incs = @vec_new {}, .defs = "" | o } in
	let tus = with_files (file_state lo) (\u = parse_from lo 0 lib_base (@vec_new {})) in
	pair_up files tus 0 (@vec_new {})

$ pair_up : @vec @str -> @vec TU -> @int -> @vec {@str, TU} -> @vec {@str, TU} = \files tus i acc =
	if i >= @vec_len tus => acc
	else pair_up files tus (i + 1) (@vec_push acc {@vec_get files i, @vec_get tus i})

# Parse the library for both targets, cache it, and write the index: every
# library file's exported names, one `name file` line each.
$ main_index : Opts -> <@io> @int = \o =
	with_diag o <| \u =
		let st = CACHE.stamp o.home,
		    o32 = Opts.{ .target = wasm32 | o },
		    o64 = Opts.{ .target = wasm64 | o } in
		let u32 = parse_library o32 in
		let u64 = parse_library o64 in
		let saved = CACHE.save (cache_path o32) st u32 && CACHE.save (cache_path o64) st u64 in
		let text = VEC.foldl (\a u = VEC.foldl (\b n = b ++ n ++ " " ++ u.0 ++ "\n") a (exports u.1)) "" u32 in
		if !saved => (eprintln "alec: error: cannot write the library cache"; 1)
		else if write_file (libc_dir o ++ "/INDEX") text => 0
		else (eprintln "alec: error: cannot write the library index"; 1)

$ file_state : Opts -> FileState = \o =
	FileState.{ .once = SET.new_str, .incs = o.incs, .sys = o.home ++ "/include" }

# The command line, `args` as `@main` receives it (the program first).
$ options : @vec @str -> <@io> Result Opts @str = \args =
	let home = find_home (@vec_get args 0) in
	parse_args args 1 Opts.{ .target = wasm32, .out = "a.wasm", .mode = Mode.Compile, .files = @vec_new {},
		.incs = @vec_new {}, .defs = "", .stdlib = @true, .home = home, .dump = @false, .verbose = @false, .quiet = @false }

# Every mode but the shell, which MAIN runs.
$ run : Opts -> <@io> @int = \o =
	is o.mode
	| Mode.Help => (print usage; 0)
	| Mode.Index => main_index o
	| _ =>
		if @vec_len o.files == 0 => (eprintln "alec: error: no input files"; 1)
		else is o.mode
			| Mode.Preprocess => main_preprocess o
			| Mode.Syntax => main_syntax o
			| Mode.Tokens.{ pp } => main_tokens o pp
			| Mode.Wasm => main_wasm o
			| _ => main_compile o
