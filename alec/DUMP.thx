$ @mod DUMP

# \file DUMP.thx
# \info The typed syntax tree as S-expressions, for `--dump-ast`: each
#       expression shows its type, so the conversions the parser inserted are
#       visible.

$ with TYPE
$ with AST
$ with PARSE
$ with LIST
$ with VEC

$ unit : TU -> @str = \tu =
	VEC.foldl (\acc g = acc ++ global tu.layout g) "" tu.globals
	++ VEC.foldl (\acc f = acc ++ func tu.layout f) "" tu.funcs

$ @private

$ global : Layout -> GVar -> @str = \lay g =
	"(global " ++ g.name ++ " : " ++ ty_name lay g.ty
	++ (if g.init => " init" else "") ++ (if g.defined => "" else " extern")
	++ (if @vec_len g.relocs > 0 => " relocs=" ++ to_string (@vec_len g.relocs) else "") ++ ")\n"

$ func : Layout -> Func -> @str = \lay f =
	"(func " ++ f.name ++ " : " ++ ty_name lay (Ty.Func.{ f.ty }) ++ "\n"
	++ LIST.foldl (\acc l = acc ++ "  (local " ++ to_string l.id ++ " " ++ l.name ++ " : " ++ ty_name lay l.ty ++ (if l.mem => " mem" else "") ++ ")\n") "" f.locals
	++ stmt lay 1 f.body ++ ")\n"

$ pad : @int -> @str = \n = if n <= 0 => "" else "  " ++ pad (n - 1)

$ stmt : Layout -> @int -> Stmt -> @str = \lay d s =
	let p = pad d in
	is s
	| Stmt.Do.{ e } => p ++ expr lay e ++ "\n"
	| Stmt.Block.{ ss } => p ++ "(block\n" ++ LIST.foldl (\acc x = acc ++ stmt lay (d + 1) x) "" ss ++ p ++ ")\n"
	| Stmt.If.{ c, a, b } => p ++ "(if " ++ expr lay c ++ "\n" ++ stmt lay (d + 1) a ++ stmt lay (d + 1) b ++ p ++ ")\n"
	| Stmt.While.{ c, b } => p ++ "(while " ++ expr lay c ++ "\n" ++ stmt lay (d + 1) b ++ p ++ ")\n"
	| Stmt.DoWhile.{ b, c } => p ++ "(do\n" ++ stmt lay (d + 1) b ++ p ++ " while " ++ expr lay c ++ ")\n"
	| Stmt.For.{ i, c, st, b } => p ++ "(for\n" ++ stmt lay (d + 1) i ++ pad (d + 1) ++ expr lay c ++ "\n" ++ pad (d + 1) ++ expr lay st ++ "\n" ++ stmt lay (d + 1) b ++ p ++ ")\n"
	| Stmt.Switch.{ e, b } => p ++ "(switch " ++ expr lay e ++ "\n" ++ stmt lay (d + 1) b ++ p ++ ")\n"
	| Stmt.Case.{ lo, hi, b } => p ++ "(case " ++ to_string lo ++ (if hi != lo => " ... " ++ to_string hi else "") ++ "\n" ++ stmt lay (d + 1) b ++ p ++ ")\n"
	| Stmt.Default.{ b } => p ++ "(default\n" ++ stmt lay (d + 1) b ++ p ++ ")\n"
	| Stmt.Break => p ++ "(break)\n"
	| Stmt.Continue => p ++ "(continue)\n"
	| Stmt.Goto.{ l } => p ++ "(goto " ++ l ++ ")\n"
	| Stmt.Label.{ l, b } => p ++ "(label " ++ l ++ "\n" ++ stmt lay (d + 1) b ++ p ++ ")\n"
	| Stmt.Return.{ e } => p ++ "(return " ++ expr lay e ++ ")\n"
	| Stmt.Empty => p ++ "(empty)\n"
	| Stmt.GotoPtr.{ e } => p ++ "(goto* " ++ expr lay e ++ ")\n"
	| Stmt.Jump.{ e, cs, d } => p ++ "(jump " ++ expr lay e ++ LIST.foldl (\acc (c: {@int, @int, @str}) = acc ++ " " ++ to_string c.0 ++ "->" ++ c.2) "" cs ++ " default->" ++ d ++ ")\n"

$ expr : Layout -> Expr -> @str = \lay e =
	let t = ":" ++ ty_name lay e.ty in
	is e.e
	| ENode.IntC.{ v } => to_string v
	| ENode.FltC.{ f } => to_string f
	| ENode.Local.{ i } => "$" ++ to_string i
	| ENode.Global.{ g } => g
	| ENode.Unary.{ op, x } => "(" ++ op ++ " " ++ expr lay x ++ ")"
	| ENode.Bin.{ op, a, b } => "(" ++ op ++ t ++ " " ++ expr lay a ++ " " ++ expr lay b ++ ")"
	| ENode.Assign.{ a, b } => "(= " ++ expr lay a ++ " " ++ expr lay b ++ ")"
	| ENode.OpAssign.{ op, a, b, ct } => "(" ++ op ++ "= " ++ expr lay a ++ " " ++ expr lay b ++ ")"
	| ENode.PostOp.{ op, a, b } => "(post" ++ op ++ " " ++ expr lay a ++ " " ++ expr lay b ++ ")"
	| ENode.Cond.{ c, a, b } => "(? " ++ expr lay c ++ " " ++ expr lay a ++ " " ++ expr lay b ++ ")"
	| ENode.Comma.{ a, b } => "(, " ++ expr lay a ++ " " ++ expr lay b ++ ")"
	| ENode.Call.{ f, args, ft } => "(call " ++ expr lay f ++ LIST.foldl (\acc a = acc ++ " " ++ expr lay a) "" args ++ ")"
	| ENode.Field.{ x, m } => "(. " ++ expr lay x ++ " " ++ m.name ++ "@" ++ to_string m.offset ++ ")"
	| ENode.Deref.{ x } => "(* " ++ expr lay x ++ ")"
	| ENode.Addr.{ x } => "(& " ++ expr lay x ++ ")"
	| ENode.Cast.{ x } => "(cast" ++ t ++ " " ++ expr lay x ++ ")"
	| ENode.Zero.{ x, n } => "(zero " ++ expr lay x ++ ")"
	| ENode.Copy.{ a, b, n } => "(copy " ++ expr lay a ++ " " ++ expr lay b ++ ")"
	| ENode.Alloca.{ x } => "(alloca " ++ expr lay x ++ ")"
	| ENode.VaStart.{ x } => "(va_start " ++ expr lay x ++ ")"
	| ENode.VaArg.{ x } => "(va_arg" ++ t ++ " " ++ expr lay x ++ ")"
	| ENode.SExpr.{ ss, x } => "({ " ++ to_string (LIST.length ss) ++ " stmts; " ++ expr lay x ++ " })"
	| ENode.LabelAddr.{ l } => "&&" ++ l
	| ENode.Nop => "nop"
