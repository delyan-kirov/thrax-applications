$ @mod MAIN

# \file MAIN.thx
# \info alec, a C compiler targeting WebAssembly (wasm32 and wasm64), written
#       in Thrax:
#           thrax run MAIN.thx -- [options] file.c...
#           node run.mjs a.wasm
#       See README.md, DRIVER for the pipeline, and SHELL for `--shell`.

$ with IO
$ with DRIVER
$ with SHELL

$ @main : @vec @str -> <@io> @int = \args =
	is DRIVER.options args
	| Result.Err.{ msg } => (eprintln ("alec: error: " ++ msg); 1)
	| Result.Ok.{ o } => is o.mode | Mode.Shell => SHELL.run o | _ => DRIVER.run o
