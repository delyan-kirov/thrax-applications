$ @mod SHELL

# \file SHELL.thx
# \info `alec --shell`: an interactive C shell, after `thrax repl`. Each entry
#       is C and is one of three things, decided by its first token:
#         a declaration (a directive, a declaration keyword, or a type name):
#                       it joins the session and later entries see it;
#         statements (ending in `;` or `}`): run once, as the body of `main`;
#         an expression: run once, and its value printed on a `//` line with
#                       its C type, so a transcript pastes back as C.
#       The session is a header the shell keeps in a scratch directory, and
#       every entry is compiled as one translation unit that includes
#       `<stdio.h>` and that header, linked with the C library (parsed once,
#       when the shell starts) and run under node. A program cannot keep
#       state between entries: statements are not replayed, so globals start
#       afresh each time. `:tokens`, `:ast` and `:wasm` show an entry's
#       tokens, typed tree and code instead of running it.
#
#       An expression's value travels back through a file: the generated
#       program writes it (an integer as text, a floating value as its bit
#       pattern), and the shell formats it, so a double prints as its
#       shortest form.

$ with IO
$ with STR
$ with OPT
$ with VEC
$ with LIST
$ with MAP
$ with LEX
$ with DIAG
$ with CFG
$ with TYPE
$ with AST
$ with PARSE
$ with PP
$ with WASM
$ with WAT
$ with DUMP
$ with DRIVER

$ Sh : @struct =
	o : Opts,
	lib : Map @str ({} -> TU),
	index : Map @str @str,
	decls : @vec @str,
	dir : @str,
	last : @str,

$ run : Opts -> <@io> @int = \o0 =
	let o = Opts.{ .files = @vec_new {} | o0 } in
	println ("alec shell: C to WebAssembly (" ++ o.target.name ++ "). `:help` for help, `:quit` to leave.");
	is load_lib o
	| Option.Some.{ lib } =>
		let dir = scratch_dir {} in
		let sh = Sh.{ .o = o, .lib = lib, .index = read_index o, .decls = @vec_new {}, .dir = dir, .last = "" } in
		save_session sh;
		loop sh;
		C.system ("rm -rf " ++ sh_quote dir);
		0
	| _ => 1

$ @private

$ help : @str =
	"Each entry is C. A declaration (a directive, or one that starts with a type)\n"
	++ "joins the session; statements ending in `;` or `}` run once as the body of\n"
	++ "`main`; anything else is an expression, run once, its value printed on a\n"
	++ "`//` line with its type. An entry continues over lines while a bracket is\n"
	++ "open. Every entry sees <stdio.h>. Globals start afresh each entry.\n"
	++ "\n"
	++ "  :type <expr>        an expression's type, without running it     (:t)\n"
	++ "  :tokens [pp] [c]    the tokens of c (default: the last entry), as\n"
	++ "                      lexed, or with `pp` after preprocessing\n"
	++ "  :ast [c]            the typed syntax tree of c\n"
	++ "  :wasm [c]           the WebAssembly code of c's functions\n"
	++ "  :wasm all           the whole module of the last entry\n"
	++ "  :target wasm32|wasm64\n"
	++ "  :list               the session's declarations                    (:l)\n"
	++ "  :reset              forget them\n"
	++ "  :help               this help                                     (:?)\n"
	++ "  :quit               leave the shell (or Ctrl-D)                   (:q)\n"

$ load_lib : Opts -> <@io> Option (Map @str ({} -> TU)) = \o =
	do (let lib = library o in Option.Some.{ MAP.map_values (\get = let tu = get {} in \u = tu) lib })
	ctl k
	   | Diag.fail e => (eprintln ("C library: " ++ render "error" e); Option.None)
	   | Diag.warn e => k {}

$ scratch_dir : {} -> <@io> @str = \u =
	let base = env "TMPDIR" in
	let d = (if base == "" => "/tmp" else base) ++ "/alec-shell-" ++ to_string (now {}) ++ "-" ++ to_string (C.clock {}) in
	C.system ("mkdir -p " ++ sh_quote d);
	d

$ sh_quote : @str -> @str = \s = "'" ++ replace s "'" "'\\''" ++ "'"

$ save_session : Sh -> <@io> {} = \sh =
	write_file (sh.dir ++ "/session.h") (VEC.foldl (\acc d = acc ++ d ++ "\n") "" sh.decls);
	{}

# -- reading entries -------------------------------------------------------------

$ loop : Sh -> <@io> {} = \sh =
	is read_entry "c> "
	| Option.Some.{ text } =>
		let t = trim text in
		if t == "" => loop sh
		else if starts_with t ":" => (is command sh t | Option.Some.{ next } => loop next | _ => {})
		else loop (entry sh t)
	| _ => println ""

$ read_entry : @str -> <@io> Option @str = \prompt =
	print prompt;
	is read_line_opt "" | Option.Some.{ line } => more line | _ => Option.None

$ more : @str -> <@io> Option @str = \acc =
	if starts_with (trim acc) ":" || complete acc => Option.Some.{ acc }
	else
		print "..> ";
		is read_line_opt "" | Option.Some.{ l } => more (acc ++ "\n" ++ l) | _ => Option.Some.{ acc }

# A line from stdin without its newline; `None` at the end of input.
$ read_line_opt : @str -> <@io> Option @str = \acc =
	let c = C.getchar {} in
	if c == 10 => Option.Some.{ acc }
	else if c >= 0 && c <= 255 => read_line_opt (@array_push acc c)
	else if @array_len acc > 0 => Option.Some.{ acc } else Option.None

# Whether an entry is finished: every bracket closed and no line continued.
$ complete : @str -> @bool = \s = depth s 0 0 0 <= 0 && !(ends_with (trim_right s) "\\")

# Open brackets, skipping string and character literals and comments; an
# unterminated comment counts as open.
$ depth : @str -> @int -> @int -> @int -> @int = \s i d q =
	if i >= @array_len s => d
	else
		let c = @array_get s i,
		    n = if i + 1 < @array_len s => @array_get s (i + 1) else 0 in
		if q != 0 => (if c == 92 => depth s (i + 2) d q else if c == q => depth s (i + 1) d 0 else depth s (i + 1) d q)
		else if c == 34 || c == 39 => depth s (i + 1) d c
		else if c == 47 && n == 47 => depth s (line_end s i) d 0
		else if c == 47 && n == 42 => (is STR.find (@array_slice s (i + 2) (@array_len s)) "*/"
			| Option.Some.{ k } => depth s (i + 4 + k) d 0
			| _ => d + 1)
		else if c == 40 || c == 91 || c == 123 => depth s (i + 1) (d + 1) 0
		else if c == 41 || c == 93 || c == 125 => depth s (i + 1) (d - 1) 0
		else depth s (i + 1) d 0

$ line_end : @str -> @int -> @int = \s i =
	if i >= @array_len s || @array_get s i == 10 => i else line_end s (i + 1)

# -- what an entry is -----------------------------------------------------------

$ Entry : @union = Decl: { @str }, Stmts: {}, Expr: {},

$ decl_words : @vec @str = ["typedef", "extern", "static", "auto", "register", "_Thread_local", "inline",
	"_Noreturn", "const", "volatile", "restrict", "_Atomic", "_Alignas", "void", "char", "short", "int",
	"long", "float", "double", "signed", "unsigned", "_Bool", "_Complex", "struct", "union", "enum",
	"_Static_assert", "typeof", "__typeof__", "__attribute__", "__extension__"]

$ classify : Sh -> @str -> <@io> Entry = \sh e =
	let decl = Entry.Decl.{ e } in
	if starts_with e "#" => decl
	else is lex "<input>" e
		| List.Cons.{ t, rest } =>
			if is_ident t && (VEC.any (\w = w == t.text) decl_words || is_type sh t.text) => decl
			else if ends_with e ";" || ends_with e "}" => Entry.Stmts
			else Entry.Expr
		| _ => Entry.Stmts

# `(name *)0` parses only when `name` names a type.
$ is_type : Sh -> @str -> <@io> @bool = \sh name =
	is parse_src sh (prelude ++ "void __alec_t(void) { (void)(" ++ name ++ " *)0; }\n")
	| Result.Ok.{ tu } => @true
	| _ => @false

# A declaration parsed in the session, with the `;` it may have left off added:
# the text the session keeps, and its unit.
$ decl_tu : Sh -> @str -> <@io> Result {@str, TU} @str = \sh d =
	is parse_src sh (decl_src d)
	| Result.Ok.{ tu } => Result.Ok.{ {d, tu} }
	| Result.Err.{ msg } =>
		if ends_with d ";" || starts_with d "#" => Result.Err.{ msg }
		else is parse_src sh (decl_src (d ++ ";"))
			| Result.Ok.{ tu } => Result.Ok.{ {d ++ ";", tu} }
			| _ => Result.Err.{ msg }

$ prelude : @str = "#include <stdio.h>\n#include \"session.h\"\n"

$ at_input : @str = "#line 1 \"<input>\"\n"

$ decl_src : @str -> @str = \d = prelude ++ at_input ++ d ++ "\n"

$ stmt_src : @str -> @str = \e = prelude ++ "int main(void) {\n" ++ at_input ++ e ++ "\n;\nreturn 0;\n}\n"

$ probe_src : @str -> @str = \e = prelude ++ "void __alec_probe(void) {\n(\n" ++ at_input ++ e ++ "\n);\n}\n"

# -- compiling and running ----------------------------------------------------------

$ input_path : Sh -> @str = \sh = sh.dir ++ "/input.c"

$ in_world : Sh -> @str -> ({} -> <Diag, @io> a) -> <@io> Result a @str = \sh src body =
	write_file (input_path sh) src;
	do Result.Ok.{ body {} }
	ctl k
	   | Diag.fail e => Result.Err.{ render "error" e }
	   | Diag.warn e => k {}

$ src_opts : Sh -> Opts = \sh = Opts.{ .files = [input_path sh] | sh.o }

$ parse_src : Sh -> @str -> <@io> Result TU @str = \sh src =
	in_world sh src (\u = let o = src_opts sh in @vec_get (with_files (file_state o) (\v = parse_all o)) 0)

$ build_src : Sh -> @str -> <@io> Result @str @str = \sh src =
	in_world sh src (\u = compile_with (src_opts sh) (\v = sh.lib) sh.index)

$ value_path : Sh -> @str = \sh = sh.dir ++ "/value"

# Run a module under node, its output going straight to the terminal; its exit
# status, reported when it is not 0.
$ run_wasm : Sh -> @str -> <@io> {} = \sh bytes =
	let path = sh.dir ++ "/entry.wasm" in
	write_file path bytes;
	let status = C.system ("node " ++ sh_quote (sh.o.home ++ "/run.mjs") ++ " " ++ sh_quote path) / 256 in
	if status != 0 => println ("  // exit status " ++ to_string status) else {}

$ entry : Sh -> @str -> <@io> Sh = \sh0 e =
	let sh = Sh.{ .last = e | sh0 } in
	is classify sh e
	| Entry.Decl.{ d } =>
		(is decl_tu sh d
		 | Result.Ok.{ r } => (let next = Sh.{ .decls = @vec_push sh.decls r.0 | sh } in save_session next; next)
		 | Result.Err.{ msg } => (println msg; sh))
	| Entry.Stmts => (run_stmts sh e; sh)
	| Entry.Expr => (run_expr sh e; sh)

$ run_stmts : Sh -> @str -> <@io> {} = \sh e =
	is build_src sh (stmt_src e)
	| Result.Ok.{ bytes } => run_wasm sh bytes
	| Result.Err.{ msg } => println msg

# The type of expression `e`, by parsing it alone as a statement: `None` when
# it does not parse (with the error), and the layout to name the type by.
$ probe : Sh -> @str -> <@io> Result {Ty, Layout} @str = \sh e =
	is parse_src sh (probe_src e)
	| Result.Ok.{ tu } =>
		(is VEC.find (\f = f.name == "__alec_probe") tu.funcs
		 | Option.Some.{ f } =>
			(is f.body
			 | Stmt.Block.{ ss } =>
				(is ss
				 | List.Cons.{ s, rest } => (is s | Stmt.Do.{ x } => Result.Ok.{ {x.ty, tu.layout} } | _ => Result.Ok.{ {t_void, tu.layout} })
				 | _ => Result.Ok.{ {t_void, tu.layout} })
			 | _ => Result.Ok.{ {t_void, tu.layout} })
		 | _ => Result.Ok.{ {t_void, tu.layout} })
	| Result.Err.{ msg } => Result.Err.{ msg }

$ run_expr : Sh -> @str -> <@io> {} = \sh e =
	is probe sh e
	| Result.Ok.{ p } =>
		if is_void p.0 => run_stmts sh (e ++ ";")
		else
			(is build_src sh (value_src sh e p.0)
			 | Result.Ok.{ bytes } =>
				remove_file (value_path sh);
				run_wasm sh bytes;
				(is read_file (value_path sh)
				 | Option.Some.{ v } => println ("  // " ++ shown v ++ " : " ++ ty_name p.1 p.0)
				 | _ => {})
			 | Result.Err.{ msg } => println msg)
	| Result.Err.{ msg } => println msg

# A `main` that evaluates `e` once, into a variable the writer below reads.
$ value_src : Sh -> @str -> Ty -> @str = \sh e t =
	let w = writer t in
	prelude ++ "int main(void) {\n" ++ w.0 ++ "\n" ++ at_input ++ e ++ "\n);\n"
	++ "FILE *__alec_f = fopen(\"" ++ c_escape (value_path sh) ++ "\", \"w\");\n"
	++ w.1 ++ "\nfclose(__alec_f);\nreturn 0;\n}\n"

# How the value is held (the start of a statement that `e` and `);` finish)
# and the statement that writes it; the first byte written says how to show
# what follows. A struct or union is evaluated but not shown.
$ writer : Ty -> {@str, @str} = \t =
	let hold = \ty = ty ++ " __alec_v = (" in
	if is_flonum t =>
		{hold "double", "union { double d; long long i; } __alec_u; __alec_u.d = __alec_v; fprintf(__alec_f, \"f%lld\", __alec_u.i);"}
	else if is_chars t =>
		{hold "const char *", "if (__alec_v) { fputc('s', __alec_f); fputs(__alec_v, __alec_f); } else fputc('n', __alec_f);"}
	else if is_bool t => {hold "int", "fprintf(__alec_f, \"v%d\", __alec_v);"}
	else if is_char t => {hold "int", "fprintf(__alec_f, \"c%d\", __alec_v);"}
	else if is_integer t =>
		(if is_unsigned t => {hold "unsigned long long", "fprintf(__alec_f, \"v%llu\", __alec_v);"}
		 else {hold "long long", "fprintf(__alec_f, \"v%lld\", __alec_v);"})
	else if is_pointerish t || is_func t =>
		{hold "unsigned long", "fprintf(__alec_f, \"v0x%lx\", __alec_v);"}
	else {"(void)(", "fputs(\"v{...}\", __alec_f);"}

$ is_char : Ty -> @bool = \t = is t | Ty.Int.{ k } => k.size == 1 && k.rank == 1 | _ => @false

$ is_chars : Ty -> @bool = \t = is_pointerish t && is_char (base_of t)

$ c_escape : @str -> @str = \s = replace (replace s "\\" "\\\\") "\"" "\\\""

# The value the program wrote, for the `//` line.
$ shown : @str -> @str = \v =
	if @array_len v == 0 => "?"
	else
		let rest = @array_slice v 1 (@array_len v) in
		is @array_get v 0
		| 102 => to_string (f64_of_bits (unwrap_or (to_int rest) 0))
		| 115 => c_string rest
		| 110 => "NULL"
		| 99 =>
			(let n = unwrap_or (to_int rest) 0 in
			 if n >= 32 && n < 127 => rest ++ " " ++ c_char n else rest)
		| _ => rest

$ c_string : @str -> @str = \s = "\"" ++ esc_go s 0 "" ++ "\""

$ c_char : @int -> @str = \n = "'" ++ esc_go (@array_push "" n) 0 "" ++ "'"

$ esc_go : @str -> @int -> @str -> @str = \s i acc =
	if i >= @array_len s => acc
	else
		let c = @array_get s i in
		esc_go s (i + 1)
			(if c == 10 => acc ++ "\\n" else if c == 9 => acc ++ "\\t" else if c == 34 => acc ++ "\\\""
			 else if c == 39 => acc ++ "\\'" else if c == 92 => acc ++ "\\\\"
			 else if c >= 32 && c < 127 => @array_push acc c
			 else acc ++ "\\x" ++ hex2 c)

$ hex2 : @int -> @str = \b =
	let d = "0123456789abcdef" in
	@array_push (@array_push "" (@array_get d (b / 16))) (@array_get d (b % 16))

# -- meta-commands ---------------------------------------------------------------

# `None` to leave the shell.
$ command : Sh -> @str -> <@io> Option Sh = \sh t =
	let name = is STR.find t " " | Option.Some.{ i } => @array_slice t 0 i | _ => t in
	let rest = trim (@array_slice t (@array_len name) (@array_len t)) in
	let code = if rest == "" => sh.last else rest in
	is name
	| ":q" | ":quit" => Option.None
	| ":help" | ":?" => (print help; Option.Some.{ sh })
	| ":list" | ":l" => (for sh.decls (\d = println d); Option.Some.{ sh })
	| ":reset" => (let next = Sh.{ .decls = @vec_new {} | sh } in save_session next; Option.Some.{ next })
	| ":type" | ":t" =>
		(if rest == "" => println "alec: `:type` needs an expression, e.g. `:type 1 + 2`"
		 else is probe sh rest
			| Result.Ok.{ p } => println (rest ++ " : " ++ ty_name p.1 p.0)
			| Result.Err.{ msg } => println msg);
		Option.Some.{ sh }
	| ":tokens" => (show_tokens sh rest; Option.Some.{ sh })
	| ":ast" => (show_ast sh code; Option.Some.{ sh })
	| ":wasm" => (show_wasm sh code (rest == "all"); Option.Some.{ sh })
	| ":target" =>
		(if rest == "wasm32" || rest == "wasm64" =>
			(let o = Opts.{ .target = (if rest == "wasm64" => wasm64 else wasm32) | sh.o } in
			 is load_lib o
			 | Option.Some.{ lib } => Option.Some.{ Sh.{ .o = o, .lib = lib | sh } }
			 | _ => Option.Some.{ sh })
		 else (println ("alec: the target is " ++ sh.o.target.name ++ "; `:target wasm32` or `:target wasm64` changes it"); Option.Some.{ sh }))
	| _ => (println ("alec: unknown command `" ++ name ++ "` (`:help` for the list)"); Option.Some.{ sh })

$ nothing : Sh -> @str -> <@io> @bool = \sh code =
	if code == "" => (println "alec: no entry yet; give some C after the command"; @true) else @false

# `pp` first means after preprocessing, with the session and <stdio.h> in
# effect; only the entry's own tokens are shown.
$ show_tokens : Sh -> @str -> <@io> {} = \sh rest =
	let pp = rest == "pp" || starts_with rest "pp " in
	let given = trim (if pp => @array_slice rest 2 (@array_len rest) else rest) in
	let code = if given == "" => sh.last else given in
	if nothing sh code => {}
	else if !pp => for (lex "<input>" code) (\t = println (DUMP.token t))
	else
		is in_world sh (decl_src code) (\u =
			let o = src_opts sh in
			with_files (file_state o) (\v = collect_tokens (\w = with_macros initial_macros (\x = run_file o (input_path sh)))))
		| Result.Ok.{ ts } => for ts (\t = if t.pos.file == "<input>" => println (DUMP.token t) else {})
		| Result.Err.{ msg } => println msg

$ opt_tu : Result {@str, TU} @str -> Result TU @str = \r =
	is r | Result.Ok.{ p } => Result.Ok.{ p.1 } | Result.Err.{ msg } => Result.Err.{ msg }

$ show_ast : Sh -> @str -> <@io> {} = \sh code =
	if nothing sh code => {}
	else
		let r = is classify sh code
			| Entry.Decl.{ d } => {opt_tu (decl_tu sh d), \n p = p.file == "<input>"}
			| Entry.Stmts => {parse_src sh (stmt_src code), \n p = n == "main"}
			| Entry.Expr => {parse_src sh (probe_src code), \n p = n == "__alec_probe"} in
		is r.0
		| Result.Ok.{ tu } => print (DUMP.unit_where tu r.1)
		| Result.Err.{ msg } => println msg

# A declaration's functions are kept alive by a `main` that takes their
# addresses; otherwise only `main` itself is shown.
$ show_wasm : Sh -> @str -> @bool -> <@io> {} = \sh code all =
	let c = if all => sh.last else code in
	if nothing sh c => {}
	else
		let r = is classify sh c
			| Entry.Decl.{ d } =>
				(is decl_tu sh d
				 | Result.Ok.{ r } =>
					(let mine = VEC.map (\f = f.name) (VEC.filter (\f = f.pos.file == "<input>") r.1.funcs) in
					 let uses = VEC.foldl (\acc n = acc ++ "(void)&" ++ n ++ "; ") "" mine in
					 {build_src sh (decl_src r.0 ++ "int main(void) { " ++ uses ++ "return 0; }\n"), \n = VEC.any (\m = m == n) mine})
				 | Result.Err.{ msg } => {Result.Err.{ msg }, \n = @false})
			| Entry.Stmts => {build_src sh (stmt_src c), \n = n == "main"}
			| Entry.Expr =>
				(is probe sh c
				 | Result.Ok.{ p } =>
					{build_src sh (if is_void p.0 => stmt_src (c ++ ";") else value_src sh c p.0), \n = n == "main"}
				 | Result.Err.{ msg } => {Result.Err.{ msg }, \n = @false}) in
		is r.0
		| Result.Ok.{ bytes } => for (if all => module_lines bytes else function_lines bytes r.1) (\l = println l)
		| Result.Err.{ msg } => println msg
