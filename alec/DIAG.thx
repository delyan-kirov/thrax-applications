$ @mod DIAG

# \file DIAG.thx
# \info Diagnostics as an effect. Every stage of alec reports through `Diag`:
#       `fail` is an error that ends the compilation (its handler never resumes,
#       so its result is any type), `warn` is reported and resumed. The driver
#       installs the one handler that knows how to print, so no stage formats or
#       prints anything itself.

$ with LEX

$ Err : @struct = pos : Pos, msg : @str,

$ Diag : @effect =
	fail : Err -> a,
	warn : Err -> {},

$ error_at : Pos -> @str -> <Diag> a = \p m = Diag.fail Err.{ .pos = p, .msg = m }
$ warn_at : Pos -> @str -> <Diag> {} = \p m = Diag.warn Err.{ .pos = p, .msg = m }

# `file:line:col: severity: message`, the shape editors and build tools parse.
$ render : @str -> Err -> @str = \severity e =
	if e.pos.line == 0 => "alec: " ++ severity ++ ": " ++ e.msg
	else e.pos.file ++ ":" ++ to_string e.pos.line ++ ":" ++ to_string e.pos.col ++ ": "
		++ severity ++ ": " ++ e.msg
