$ @mod LIT

# \file LIT.thx
# \info Decoding C literal spellings into values: integer and floating
#       constants (with their suffixes), character constants, and string
#       literals (escapes, UTF-8, and the wide `L`/`u`/`U` forms). Both the
#       preprocessor's `#if` evaluator and the parser read numbers through here,
#       so the two always agree on what a spelling means.

$ with STR
$ with OPT
$ with BITS

# `longs` counts the `l` suffixes (0, 1 or 2); `decimal` matters because an
# unsuffixed decimal constant never becomes unsigned on its own, while an octal
# or hex one does when it does not fit the signed type.
$ IntLit : @struct = value : @int, unsigned : @bool, longs : @int, decimal : @bool, overflow : @bool,

# `kind` is 0 for `double`, 1 for `float`, 2 for `long double`.
$ FloatLit : @struct = value : @float64, kind : @int,

# A string literal's code units; `width` is the unit size in bytes (1 for plain
# and `u8`, 2 for `u`, 4 for `U` and `L`). No terminator is included.
$ StrLit : @struct = units : @vec @int, width : @int,

$ is_float_text : @str -> @bool = \s =
	let hex = starts_with s "0x" || starts_with s "0X" in
	contains s "." || (if hex => contains s "p" || contains s "P" else contains s "e" || contains s "E")

$ int_lit : @str -> Option IntLit = \text =
	let s = strip_seps text 0 "" in
	let hex = starts_with s "0x" || starts_with s "0X",
	    bin = starts_with s "0b" || starts_with s "0B" in
	let base = if hex => 16 else if bin => 2 else if starts_with s "0" && @array_len s > 1 => 8 else 10,
	    from = if hex || bin => 2 else 0 in
	let end = digits_end s from base in
	if end == from && !(base == 8) => Option.None
	else
		let v = digits_value s from end base 0 @false in
		is suffix (to_lower (@array_slice s end (@array_len s)))
		| Option.Some.{ sx } =>
			Option.Some.{ IntLit.{ .value = v.0, .unsigned = sx.0, .longs = sx.1, .decimal = base == 10, .overflow = v.1 } }
		| _ => Option.None

$ float_lit : @str -> Option FloatLit = \text =
	let s = strip_seps text 0 "",
	    n = @array_len s in
	let last = if n > 0 => @array_get s (n - 1) else 0 in
	let hex = starts_with s "0x" || starts_with s "0X" in
	let kind = if last == 102 || last == 70 => 1 else if last == 108 || last == 76 => 2 else 0 in
	let body = if kind == 0 => s else @array_slice s 0 (n - 1) in
	if valid_float body hex => Option.Some.{ FloatLit.{ .value = from_string body, .kind = kind } }
	else Option.None

# The value of a character constant, as the `int` (or `wchar_t`, `char16_t`,
# `char32_t`) it denotes. A plain `'x'` is a `char`, which is signed here, so a
# byte above 127 is negative; several characters pack big-endian, as GCC does.
$ char_value : @str -> @int = \text =
	let pre = prefix_of text in
	let body = @array_slice text (@array_len pre + 1) (@array_len text - 1) in
	if pre == "" =>
		let us = decode body 1 in
		if @vec_len us == 1 => sext (@vec_get us 0) 8
		else sext (pack us 0 0) 32
	else
		let us = decode body (if pre == "u8" => 1 else 4) in
		let v = if @vec_len us == 0 => 0 else @vec_get us 0 in
		if pre == "u" => zext v 16 else if pre == "u8" => zext v 8 else if pre == "U" => zext v 32 else sext v 32

# The prefix of a character constant or string literal: "", "L", "u", "U", "u8".
$ prefix_of : @str -> @str = \text =
	if starts_with text "u8" => "u8"
	else if starts_with text "L" => "L"
	else if starts_with text "u" => "u"
	else if starts_with text "U" => "U"
	else ""

$ width_of_prefix : @str -> @int = \pre =
	if pre == "u" => 2 else if pre == "U" || pre == "L" => 4 else 1

# One string literal token's contents.
$ str_value : @str -> StrLit = \text =
	let pre = prefix_of text in
	let w = width_of_prefix pre in
	let body = @array_slice text (@array_len pre + 1) (@array_len text - 1) in
	StrLit.{ .units = decode body w, .width = w }

# Decode the body of a literal into code units of `w` bytes. Source bytes are
# UTF-8: copied as bytes into a narrow literal, decoded to code points for a wide
# one (and split into surrogate pairs for `u`). `\x` and octal escapes give one
# unit as written, `\u`/`\U` a code point.
$ decode : @str -> @int -> @vec @int = \s w = decode_go s 0 w (@vec_new {})

$ @private

$ strip_seps : @str -> @int -> @str -> @str = \s i acc =
	if i >= @array_len s => acc
	else
		let c = @array_get s i in
		strip_seps s (i + 1) (if c == 39 => acc else @array_push acc c)

$ digit_val : @int -> @int = \c =
	if c >= 48 && c <= 57 => c - 48
	else if c >= 97 && c <= 102 => c - 87
	else if c >= 65 && c <= 70 => c - 55
	else 99

$ digits_end : @str -> @int -> @int -> @int = \s i base =
	if i < @array_len s && digit_val (@array_get s i) < base => digits_end s (i + 1) base else i

# The value modulo 2^64, and whether it overflowed 64 bits.
$ digits_value : @str -> @int -> @int -> @int -> @nat -> @bool -> {@int, @bool} = \s i end base acc ov =
	if i >= end => (let r : @int = @cast acc in {r, ov})
	else
		let b : @nat = @cast base,
		    d : @nat = @cast (digit_val (@array_get s i)) in
		let next = acc * b + d in
		digits_value s (i + 1) end base next (ov || (acc > 0 && next / b < acc))

# The suffix as {unsigned, number of `l`s}, or None when it is not a valid one.
$ suffix : @str -> Option {@bool, @int} = \s =
	is s
	| "" => Option.Some.{ {@false, 0} }
	| "u" => Option.Some.{ {@true, 0} }
	| "l" => Option.Some.{ {@false, 1} }
	| "ul" | "lu" => Option.Some.{ {@true, 1} }
	| "ll" => Option.Some.{ {@false, 2} }
	| "ull" | "llu" => Option.Some.{ {@true, 2} }
	| "z" => Option.Some.{ {@false, 1} }
	| "uz" | "zu" => Option.Some.{ {@true, 1} }
	| _ => Option.None

$ valid_float : @str -> @bool -> @bool = \s hex =
	let ok = \c = is_alnum c || c == 46 || c == 43 || c == 45 in
	@array_len s > 0 && all_bytes ok s 0 && (hex || is_digit (@array_get s 0) || @array_get s 0 == 46)

$ all_bytes : (@int -> @bool) -> @str -> @int -> @bool = \ok s i =
	if i >= @array_len s => @true else ok (@array_get s i) && all_bytes ok s (i + 1)

$ pack : @vec @int -> @int -> @int -> @int = \us i acc =
	if i >= @vec_len us => acc else pack us (i + 1) (acc * 256 + zext (@vec_get us i) 8)

$ decode_go : @str -> @int -> @int -> @vec @int -> @vec @int = \s i w acc =
	if i >= @array_len s => acc
	else
		let c = @array_get s i in
		if c == 92 =>
			let e = escape s (i + 1) in
			decode_go s e.1 w (if e.2 => put_cp acc e.0 w else @vec_push acc (zext e.0 (w * 8)))
		else if w == 1 || c < 128 => decode_go s (i + 1) w (@vec_push acc c)
		else
			let u = utf8 s i in
			decode_go s u.1 w (put_cp acc u.0 w)

# A code point as units: UTF-8 bytes for a narrow literal, one unit or a
# surrogate pair for `u`, one unit for `U`/`L`.
$ put_cp : @vec @int -> @int -> @int -> @vec @int = \acc cp w =
	if w == 4 => @vec_push acc cp
	else if w == 2 =>
		(if cp < 65536 => @vec_push acc cp
		 else let v = cp - 65536 in
			@vec_push (@vec_push acc (55296 + shr_u v 10)) (56320 + band v 1023))
	else if cp < 128 => @vec_push acc cp
	else if cp < 2048 => @vec_push (@vec_push acc (192 + shr_u cp 6)) (128 + band cp 63)
	else if cp < 65536 =>
		@vec_push (@vec_push (@vec_push acc (224 + shr_u cp 12)) (128 + band (shr_u cp 6) 63)) (128 + band cp 63)
	else
		@vec_push (@vec_push (@vec_push (@vec_push acc (240 + shr_u cp 18)) (128 + band (shr_u cp 12) 63))
			(128 + band (shr_u cp 6) 63)) (128 + band cp 63)

# One UTF-8 sequence at `i`: the code point and the offset after it. A malformed
# byte stands for itself.
$ utf8 : @str -> @int -> {@int, @int} = \s i =
	let c = @array_get s i,
	    n = if c >= 240 => 3 else if c >= 224 => 2 else if c >= 192 => 1 else 0 in
	if n == 0 || i + n >= @array_len s => {c, i + 1}
	else
		let lead = if n == 3 => band c 7 else if n == 2 => band c 15 else band c 31 in
		{utf8_more s (i + 1) n lead, i + 1 + n}

$ utf8_more : @str -> @int -> @int -> @int -> @int = \s i n acc =
	if n == 0 => acc else utf8_more s (i + 1) (n - 1) (acc * 64 + band (@array_get s i) 63)

# An escape after the backslash at `i - 1`: its value, the offset after it, and
# whether it names a code point (`\u`, `\U`) rather than a raw unit.
$ escape : @str -> @int -> {@int, @int, @bool} = \s i =
	let c = if i < @array_len s => @array_get s i else 0 in
	if c == 110 => {10, i + 1, @false}
	else if c == 116 => {9, i + 1, @false}
	else if c == 114 => {13, i + 1, @false}
	else if c == 48 && !(i + 1 < @array_len s && is_odigit (@array_get s (i + 1))) => {0, i + 1, @false}
	else if c == 97 => {7, i + 1, @false}
	else if c == 98 => {8, i + 1, @false}
	else if c == 102 => {12, i + 1, @false}
	else if c == 118 => {11, i + 1, @false}
	else if c == 101 => {27, i + 1, @false}
	else if c == 120 => let e = hex_run s (i + 1) 0 in {e.0, e.1, @false}
	else if c == 117 => let e = hex_n s (i + 1) 4 0 in {e.0, e.1, @true}
	else if c == 85 => let e = hex_n s (i + 1) 8 0 in {e.0, e.1, @true}
	else if is_odigit c => let e = oct_run s i 0 0 in {e.0, e.1, @false}
	else {c, i + 1, @false}

$ is_odigit : @int -> @bool = \c = c >= 48 && c <= 55

$ hex_run : @str -> @int -> @int -> {@int, @int} = \s i acc =
	if i < @array_len s && digit_val (@array_get s i) < 16 => hex_run s (i + 1) (acc * 16 + digit_val (@array_get s i))
	else {acc, i}

$ hex_n : @str -> @int -> @int -> @int -> {@int, @int} = \s i n acc =
	if n == 0 || i >= @array_len s || digit_val (@array_get s i) >= 16 => {acc, i}
	else hex_n s (i + 1) (n - 1) (acc * 16 + digit_val (@array_get s i))

$ oct_run : @str -> @int -> @int -> @int -> {@int, @int} = \s i n acc =
	if n < 3 && i < @array_len s && is_odigit (@array_get s i) => oct_run s (i + 1) (n + 1) (acc * 8 + @array_get s i - 48)
	else {acc, i}
