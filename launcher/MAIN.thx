@mod MAIN

# \file MAIN.thx
# \info A minimal program launcher, written in Thrax against raylib. Type to
#       filter the list, then click a row (or press Enter) to spawn the program it
#       names. The raylib API is imported from RAYLIB.thx, which is GENERATED by
#       the cbindgen tool from raylib's header (`Color` is a real
#       `@struct @extern "C"` passed BY VALUE). A C function is never curried, so
#       a multi-parameter raylib call takes a record of its arguments:
#       `drawRectangle { .p0 = x, .p1 = y, ... }`.
#
#       The UI state is one `Model`, reached through the `Ui` effect: each frame
#       is a handful of steps that read and update it, run by `for forever`, and
#       `break` closes the launcher. Run it from THIS directory (the flake links
#       `bin/libraylib.so` and `library/`):
#           nix develop   &&   thrax run MAIN.thx
#       Regenerate the bindings with:
#           LIB=bin/libraylib.so MOD=RAYLIB OUT=RAYLIB.thx \
#             thrax run ../cbindgen/MAIN.thx <path-to>/raylib.h

$ with RAYLIB
$ with STR
$ with OPT

# Spawn a program (fire-and-forget) via libc. The `&` in the command returns at
# once. Not part of raylib, so it stays a local `@extern`.
$ system : @str -> <@io> @int = @extern "C" "system" "libc"

# -- palette (ordinary struct literals, passed to raylib by value) -----------
$ bg        : Color = Color.{ .r = 4,   .g = 10,  .b = 22,  .a = 255 }
$ btn_col   : Color = Color.{ .r = 11,  .g = 22,  .b = 42,  .a = 255 }
$ hover_col : Color = Color.{ .r = 11,  .g = 20,  .b = 46,  .a = 255 }   # dark navy highlight
$ text_col  : Color = Color.{ .r = 214, .g = 224, .b = 240, .a = 255 }
$ sep_col   : Color = Color.{ .r = 40,  .g = 60,  .b = 92,  .a = 255 }   # row divider lines

# -- command-mode config (edit to taste) -------------------------------------
# The terminal `!` and `$` open, and the URL prefix `?` searches through.
$ terminal    : @str = "cosmic-term"
$ search_url  : @str = "https://duckduckgo.com/?q="
$ cmd_timeout : @str = "2"   # seconds a captured `!`/`$` command may run before it is killed

# -- the launchable programs --------------------------------------------------
# The list is DISCOVERED from the system's `.desktop` files (see `scan_cmd`).
# This hardcoded set is only the fallback when none are found. `cmd` is the raw
# program to run (no trailing `&`); `terminal` marks a CLI/TUI app
# (`Terminal=true` in its desktop entry) that must run inside a terminal. `key`
# is the lowercased label, computed once so filtering does not redo it per frame.
$ App : @struct = label: @str, key: @str, cmd: @str, terminal: @bool,

$ app : @str -> @str -> @bool -> App = \label, cmd, term =
	App.{ .label = label, .key = to_lower label, .cmd = cmd, .terminal = term }

$ fallback_apps : @vec App =
	[ app "Terminal" "xterm"      @false
	, app "Files"    "xdg-open ." @false
	, app "Browser"  "firefox"    @false ]

# -- layout ------------------------------------------------------------------
$ pad      : @int32 = 20
$ search_y : @int32 = 48
$ top      : @int32 = 116
$ btn_w    : @int32 = 380
$ btn_h    : @int32 = 48
$ gap      : @int32 = 12
$ base_w   : @int32 = 420   # window size showing the app list (no output)
$ base_h   : @int32 = 320
$ ui_fs      : @float32 = 20.0   # app labels and the search box
$ out_fs     : @float32 = 18.0   # the captured command output
$ spacing    : @float32 = 0.0    # raylib glyph spacing (a bare 0.0 defaults to Real)
$ round_amt  : @float32 = 0.2    # hover-box roundness (0 = sharp box, small = softly rounded)
$ round_seg  : @int32 = 16       # corner smoothness of the hover box
$ line_h     : @int32 = 27       # raylib advances ~1.5x the output font per newline
$ font_atlas : @int32 = 48       # px the glyph atlas is baked at, then scaled down
$ max_list_h : @int32 = 760      # tallest the app-list window grows before it scrolls

# int <-> float32 for raylib's text API, whose positions and sizes are @float32
# (`@cast` crosses only integer widths; `C.i2f`/`C.f2i` bridge int and float).
$ i2f32 : @int32 -> @float32 = \n = C.i2f (@cast n)
$ f2i32 : @float32 -> @int32 = \x = @cast (C.f2i x)

# List positions are @int (they index a @vec); pixels are @int32 (raylib's).
$ px : @int -> @int32 = \n = @cast n

$ max_i32 : @int32 -> @int32 -> @int32 = \a, b = if a >= b => a else b
$ min_i32 : @int32 -> @int32 -> @int32 = \a, b = if a < b => a else b

# One list row is a button plus its trailing gap. `rows_fit` is how many rows fit
# before `max_list_h`; `list_height` is the window height that shows `rows` of them.
$ row_stride  : @int32 = btn_h + gap
$ rows_fit    : @int = @cast ((max_list_h - top) / row_stride)
$ list_height : @int -> @int32 = \rows = top + px rows * row_stride + pad
$ row_y       : @int -> @int32 = \i = top + px i * row_stride

# The list row under (mx, my), if any. The gap below a row belongs to no row.
$ row_at : @int32 -> @int32 -> @int -> Option @int = \mx, my, rows =
	let r : @int = @cast ((my - top) / row_stride) in
	if
		mx < pad || mx >= pad + btn_w || my < top => Option.None,
		r < rows && (my - top) % row_stride < btn_h => Option.Some.{ r },
	else Option.None

# -- the model ---------------------------------------------------------------
# The app scan is a coroutine (see `scan_apps`). While it runs, the model holds
# it `Paused` at its last `Feed.pause`; resuming it with @true runs it one more
# slice, with @false asks it to stop.
$ Scan : @union = Paused: {@bool -> <Ui, @io> Scan}, Done: {},

# `visible` is `apps` filtered by `query`, kept in step by `refilter` so the
# filter runs when either changes rather than every frame. `off` is the scroll
# offset into `visible`. The list stays hidden until the first keystroke
# (`typed`). `win_w`/`win_h` mirror the window, so it is resized only on change.
$ Model : @struct =
	apps: @vec App, scan: Scan, query: @str, visible: @vec App,
	output: @str, off: @int, typed: @bool, win_w: @int32, win_h: @int32,

# The launcher's state, as an effect: `model` reads it, `set` replaces it.
$ Ui : @effect = model : {} -> Model, set : Model -> {},

$ modify : (Model -> Model) -> <Ui> {} = \f = Ui.set (f (Ui.model {}))

# Handle `Ui` by passing the model along: each clause returns a function of the
# current model, so `body` sees every `set` that came before.
$ with_model : Model -> ({} -> <Ui, @io> {}) -> <@io> {} = \m0, body =
	let run = do body {}
		ctl k | Ui.model u => \m = (k m) m
		      | Ui.set m2  => \m = (k {}) m2
		      | _          => \m = {}
	in run m0

$ matching : @vec App -> @str -> @vec App = \apps, q =
	let needle = to_lower q in
	formap apps <| \a = if contains a.key needle => a else continue {}

$ refilter : Model -> Model = \m = Model.{ .visible = matching m.apps m.query | m }

# How many list rows are on screen.
$ rows : Model -> @int = \m =
	let n = @vec_len m.visible in
	if not m.typed => 0, n < rows_fit => n else rows_fit

# -- app discovery -----------------------------------------------------------
# Collect the `.desktop` file paths in every XDG `applications` directory and let
# one embedded `awk` pass extract `Name<TAB>Exec<TAB>Terminal`. This runs outside
# Thrax on purpose: awk reads and parses ~150 files in ~40 ms, and Thrax only
# splits the resulting handful of lines. The awk program reads only the
# `[Desktop Entry]` group, strips `Exec` field codes (`%f`, ...), and drops
# hidden/non-app entries. (In the awk source, `{` is escaped `\{` and `[` `\\[` so
# the Thrax string lexer leaves them alone.)
$ scan_cmd : @str =
	"dirs=\"$XDG_DATA_HOME\"; [ -n \"$dirs\" ] || dirs=\"$HOME/.local/share\"; "
	++ "more=\"$XDG_DATA_DIRS\"; [ -n \"$more\" ] || more=\"/usr/local/share:/usr/share\"; "
	++ "all=\"$dirs:$more\"; "
	++ "( IFS=:; set --; for d in $all; do for f in \"$d\"/applications/*.desktop; do "
	++ "[ -f \"$f\" ] && set -- \"$@\" \"$f\"; done; done; "
	++ "awk '"
	++ "function emit() \{ if (nd != \"true\" && ty == \"Application\" && nm != \"\" && ex != \"\") printf \"%s\\t%s\\t%s\\n\", nm, ex, (tolower(tm) == \"true\" ? 1 : 0) }\n"
	++ "FNR == 1 \{ if (started) emit(); started = 1; nm = \"\"; ex = \"\"; tm = \"\"; nd = \"\"; ty = \"\"; ine = 0 }\n"
	++ "/^\\[Desktop Entry\\]/ \{ ine = 1; next }\n"
	++ "/^\\[/ \{ ine = 0; next }\n"
	++ "!ine \{ next }\n"
	++ "/^Name=/ && nm == \"\" \{ nm = substr($0, 6) }\n"
	++ "/^Exec=/ && ex == \"\" \{ ex = substr($0, 6); gsub(/ *%[a-zA-Z]/, \"\", ex) }\n"
	++ "/^Terminal=/ \{ tm = substr($0, 10) }\n"
	++ "/^NoDisplay=/ \{ nd = substr($0, 11) }\n"
	++ "/^Type=/ \{ ty = substr($0, 6) }\n"
	++ "END \{ if (started) emit() }"
	++ "' \"$@\" 2>/dev/null ) | sort -u"

# `popen` hands back a FILE* as a word-sized @int, exactly like `C.fopen`.
$ popen  : {cmd: @str, mode: @str} -> <@io> @int = @extern "C" "popen"  "libc"
$ pclose : @int -> <@io> @int                   = @extern "C" "pclose" "libc"
$ fileno : @int -> <@io> @int32                 = @extern "C" "fileno" "libc"

# Has the pipe anything to read (data, or its end)? A zero-timeout poll(2), so it
# never blocks. 1 is POLLIN; hang-up is always reported.
$ PollFd : @struct @extern "C" = fd: @int32, events: @int16, revents: @int16,
$ poll   : {fds: @vec PollFd, n: @nat64, timeout: @int32} -> <@io> @int32 = @extern "C" "poll" "libc"

$ readable : @int -> <@io> @bool = \f =
	poll { [PollFd.{ .fd = fileno f, .events = 1, .revents = 0 }], 1, 0 } > 0

$ is_byte : @int -> @bool = \c = if c < 0 => @false else c <= 255

# One line from a stream, without its '\n'; `None` once the stream has ended.
$ read_line : @int -> @str -> <@io> Option @str = \f, acc =
	let c = C.fgetc f in
	if
		c == 10 => Option.Some.{ acc },
		is_byte c => read_line f (@array_push acc c),
		is_empty acc => Option.None,
	else Option.Some.{ acc }

$ parse_app : @str -> Option App = \line =
	is split line "\t"
	| [name, cmd, term] => Option.Some.{ app name cmd (term == "1") }
	| _ => Option.None

# What the scan coroutine performs: `found` delivers one app, `pause` hands the
# frame back and answers whether to keep going.
$ Feed : @effect = found : App -> {}, pause : {} -> @bool,

$ lines_per_frame : @int = 8

# The scan, written as if it owned the thread: wait for the pipe, read a few
# lines, deliver them, repeat. Every `pause` is a frame boundary, and the pipe is
# only read once poll(2) says it will not block, so no frame waits on it.
$ produce : @int -> <Feed, @io> {} = \f =
	when (Feed.pause {}) <| \_ =
		if readable f => take f lines_per_frame else produce f

$ take : @int -> @int -> <Feed, @io> {} = \f, n =
	if n == 0 => produce f
	else is read_line f ""
		| Option.Some.{ line } =>
			when (parse_app line) (\a = Feed.found a) ;
			take f (n - 1)
		| _ => {}

$ scan_apps : @int -> <Feed, @io> {} = \f =
	defer pclose f in
	produce f

# Run the scan up to its next `pause`. Each `found` app joins the model; a
# `pause` suspends the scan as a stored continuation. When it ends with nothing
# found, the fallback list stands in.
$ scanning : ({} -> <Feed, Ui, @io> {}) -> <Ui, @io> Scan = \body =
	do body {}
	ctl k | Feed.found a => modify (\m = Model.{ .apps = @vec_push m.apps a | m }) ; k {}
	      | Feed.pause u => Scan.Paused.{ k }
	      | _ =>
	        modify (\m = if @vec_len m.apps == 0 => Model.{ .apps = fallback_apps | m } else m) ;
	        Scan.Done

# The scan before its first slice. A failed `popen` (0) finds nothing.
$ start_scan : @int -> Scan = \f =
	Scan.Paused.{ \go = scanning <| \_ =
		if f == 0 => {}, go => scan_apps f else (pclose f ; {}) }

# Resume the scan with `go`, then store wherever it stopped next.
$ resume_scan : @bool -> <Ui, @io> {} = \go =
	is (Ui.model {}).scan
	| Scan.Paused.{ k } =>
		let next = k go in
		modify (\m = refilter Model.{ .scan = next | m })
	| _ => {}

$ scan_step : {} -> <Ui, @io> {} = \_ = resume_scan @true

# Quitting mid-scan tells it to stop, so its `defer` reaps the child.
$ stop_scan : {} -> <Ui, @io> {} = \_ = resume_scan @false

# -- the query ---------------------------------------------------------------
# Drain raylib's character queue onto the query. `getCharPressed` yields a C
# `int` codepoint (0 when the queue is empty); `from_byte` wants an `@int`, so
# each printable ASCII code crosses the width boundary with `@cast`.
$ read_chars : @str -> @str = \q =
	let c = getCharPressed {} in
	if
		c == 0 => q,
		c >= 32 && c < 127 => read_chars (q ++ from_byte (@cast c)),
	else read_chars q

$ drop_last : @str -> @str = \s =
	if len s > 0 => substr s 0 (len s - 1) else s

$ pressed : I32 -> @bool = \k = isKeyPressed k == 1

# A key fires this frame if pressed now or auto-repeating (so a held arrow key
# keeps scrolling).
$ key_step : I32 -> @bool = \k = pressed k || isKeyPressedRepeat k == 1

# Typed chars, backspace, and escape (which clears the query and any output).
# Any change to the query resets the scroll and drops the output.
$ edit_step : {} -> <Ui> {} = \_ =
	let m = Ui.model {},
	    q1 = read_chars m.query,
	    q2 = if key_step key_backspace => drop_last q1 else q1,
	    typed = if is_empty q2 => m.typed else @true in
	if
		pressed key_escape => Ui.set (refilter Model.{ .query = "", .output = "", .off = 0 | m }),
		q2 == m.query => {},
	else Ui.set (refilter Model.{ .query = q2, .output = "", .off = 0, .typed = typed | m })

# This frame's scroll intent in list rows: mouse wheel (a notch is one row),
# arrow keys by one row, page keys by a whole page. Positive scrolls DOWN.
$ scroll_delta : {} -> @int = \_ =
	let wheel : @int = @cast (0 - f2i32 (getMouseWheelMove {})),
	    keys = (if key_step key_down => 1 else 0) - (if key_step key_up => 1 else 0),
	    pages = (if key_step key_page_down => rows_fit else 0)
	          - (if key_step key_page_up => rows_fit else 0) in
	wheel + keys + pages

# Clamp `off` into [0, n - rows_fit]: never past the last full page, never below 0.
$ clamp_off : @int -> @int -> @int = \off, n =
	let last = if n > rows_fit => n - rows_fit else 0 in
	if off < 0 => 0, off > last => last else off

$ scroll_step : {} -> <Ui> {} = \_ =
	let d = scroll_delta {} in
	when (d != 0) <| \_ =
		modify <| \m = Model.{ .off = clamp_off (m.off + d) (@vec_len m.visible) | m }

# -- commands ----------------------------------------------------------------
# Spawn a shell command in a fresh terminal window that stays open afterward.
$ in_terminal : @str -> <@io> @int = \cmd =
	system (terminal ++ " -e sh -c '" ++ cmd ++ "; exec $SHELL' &")

# Launch an app: a `Terminal=true` (CLI/TUI) app runs inside a terminal window,
# everything else is spawned fire-and-forget as a background GUI process.
$ launch : App -> <@io> @int = \a =
	if a.terminal => in_terminal a.cmd
	else system (a.cmd ++ " &")

# Read a stream to its end, at most `budget` bytes, so a chatty command cannot
# stall the frame loop.
$ drain : @int -> @int -> @str -> <@io> @str = \f, budget, acc =
	if budget <= 0 => acc
	else
		let c = C.fgetc f in
		if is_byte c => drain f (budget - 1) (@array_push acc c)
		else acc

# Single-quote a string for the shell, so the whole command reaches one `sh -c`
# as a single argument (spaces, pipes and `;` included). A literal `'` becomes
# `'\''`: close the quote, an escaped quote, reopen.
$ shell_quote : @str -> @str = \s = "'" ++ replace s "'" "'\\''" ++ "'"

# `pclose` hands back a wait(2) status; `timeout` exits 124 when it had to kill
# the command, which sits in the high byte (WEXITSTATUS).
$ timed_out : @int -> @bool = \status = (status / 256) % 256 == 124

# Run a shell command under `timeout` and capture its stdout+stderr. If it runs
# longer than `cmd_timeout` seconds it is killed and the window shows a timeout
# message instead of partial output. The command runs inside its own `sh -c` so
# `timeout` covers the whole pipeline, not just the first word.
$ run_capture : @str -> <@io> @str = \cmd =
	let wrapped = "timeout -k 1 " ++ cmd_timeout ++ " sh -c " ++ shell_quote cmd ++ " 2>&1",
	    f = popen {wrapped, "r"} in
	if f == 0 => ""
	else let
		body = drain f 2000 "",
		status = pclose f
	in if timed_out status =>
			"command timed out"
		else
			body

# Hand the query to the web browser as a search, spaces percent-escaped as `+`.
$ open_search : @str -> <@io> @int = \q =
	system ("xdg-open '" ++ search_url ++ replace q " " "+" ++ "' &")

# Curated `$name` tools. An empty result means "no such tool".
$ tool_cmd : @str -> @str = \name =
	is name
	| "time" => "date"
	| "cal"  => "cal"
	| "disk" => "df -h"
	| "mem"  => "free -h"
	| _      => ""

$ show_output : Model -> @str -> <Ui> {} = \m, out =
	Ui.set (refilter Model.{ .query = "", .output = out, .off = 0 | m })

# Enter commits the query by its leading sigil. `!` runs a shell command and `$`
# a curated tool, showing the output in the window (an unknown tool leaves the
# query, typo visible); `?` opens a web search. A plain query launches the first
# visible app. Handing off to another program ends the launcher.
$ commit : Model -> <Ui, Loop, @io> {} = \m =
	is m.query
	| "!" ++ cmd => show_output m (run_capture (trim cmd))
	| "?" ++ q   => open_search (trim q); break {}
	| "$" ++ name =>
		let cmd = tool_cmd (trim name) in
		when (cmd != "") <| \_ = show_output m (run_capture cmd)
	| _ => when (VEC.first m.visible) <| \a = launch a ; break {}

$ enter_step : {} -> <Ui, Loop, @io> {} = \_ =
	when (pressed key_enter || pressed key_kp_enter) <| \_ = commit (Ui.model {})

# A click on a list row launches that row's app.
$ click_step : {} -> <Ui, Loop, @io> {} = \_ =
	let m = Ui.model {} in
	when (isMouseButtonPressed mouse_button_left == 1 && is_empty m.output) <| \_ =
		when (row_at (getMouseX {}) (getMouseY {}) (rows m)) <| \r =
			launch (@vec_get m.visible (m.off + r)) ; break {}

# -- rendering ---------------------------------------------------------------
# The day and time shown in the header, from libc `ctime` (no `date` fork, so it
# is cheap enough to recompute every frame). `time` wants a `time_t*`, so `le8`
# serializes the current epoch into an 8-byte little-endian buffer to hand it as
# an INPUT pointer (the FFI copies byte-buffer arguments, which is fine for an
# input). `ctime` returns the fixed "Www Mmm dd hh:mm:ss yyyy\n"; we keep the
# "Www Mmm dd" date and the "hh:mm" time, dropping seconds and year.
$ ctime : @str -> @str = @extern "C" "ctime" "libc"

$ le8 : @int -> @int -> @str = \t, k =
	if k >= 8 => "" else (@array_push "" (t % 256)) ++ le8 (t / 256) (k + 1)

$ clock_str : {} -> <@io> @str = \_ =
	let s = ctime (le8 (C.time 0) 0) in
	substr s 0 10 ++ "   " ++ substr s 11 16

# Draw `s` at (x, y) in `font`; positions and the size cross to @float32 here.
$ text : Font -> @str -> @int32 -> @int32 -> @float32 -> Color -> {} =
	\font, s, x, y, size, col =
		drawTextEx { .p0 = font, .p1 = s,
		             .p2 = Vector2.{ .x = i2f32 x, .y = i2f32 y },
		             .p3 = size, .p4 = spacing, .p5 = col }

# Width in pixels of the widest line of `s` drawn in `font` at `out_fs`.
$ widest : Font -> @str -> @int32 = \font, s =
	let w = \l = f2i32 (measureTextEx { .p0 = font, .p1 = l, .p2 = out_fs, .p3 = spacing }).x in
	VEC.foldl (\acc, l = max_i32 acc (w l)) 0 (split s "\n")

# The window fits what it shows. With no output it fits the app list, never
# below `base_h`; with output it grows to the longest line and every line, both
# capped against the screen. raylib is only asked when the size changes.
$ resize_step : Font -> <Ui> {} = \font =
	let m = Ui.model {},
	    w = if is_empty m.output => base_w
	        else min_i32 1200 (max_i32 base_w (widest font m.output + 2 * pad)),
	    h = if is_empty m.output => max_i32 base_h (list_height (rows m))
	        else min_i32 800 (top + px (@vec_len (split m.output "\n")) * line_h + pad) in
	when (w != m.win_w || h != m.win_h) <| \_=
		setWindowSize { .p0 = w, .p1 = h } ;
		Ui.set Model.{ .win_w = w, .win_h = h | m }

# A hovered row is a filled rounded ("oval") box; an idle row is just its label
# fenced by two thin divider lines (top and bottom edges).
$ draw_row : Font -> App -> @int32 -> @bool -> {} = \font, a, y, hover =
	(if hover
		=> drawRectangleRounded
			{ .p0 = Rectangle.{ .x = i2f32 pad, .y = i2f32 y,
			                    .width = i2f32 btn_w, .height = i2f32 btn_h },
			  .p1 = round_amt, .p2 = round_seg, .p3 = hover_col }
		else
			(drawLine { .p0 = pad, .p1 = y,         .p2 = pad + btn_w, .p3 = y,         .p4 = sep_col } ;
			 drawLine { .p0 = pad, .p1 = y + btn_h, .p2 = pad + btn_w, .p3 = y + btn_h, .p4 = sep_col })) ;
	text font a.label (pad + 16) (y + 14) ui_fs text_col

$ draw_list : Font -> Model -> {} = \font, m =
	let n = rows m,
	    hover = row_at (getMouseX {}) (getMouseY {}) n in
	for (range 0 (n - 1)) <| \i =
		let hovered = is hover | Option.Some.{ r } => r == i | _ => @false in
		draw_row font (@vec_get m.visible (m.off + i)) (row_y i) hovered

$ draw_step : Font -> <Ui, @io> {} = \font =
	resize_step font ;
	let m = Ui.model {} in
	beginDrawing {} ;
	clearBackground bg ;
	text font (clock_str {}) (pad + 12) 14 ui_fs sep_col ;
	drawRectangle { .p0 = pad, .p1 = search_y, .p2 = btn_w, .p3 = btn_h, .p4 = btn_col } ;
	text font (m.query ++ "_") (pad + 12) (search_y + 14) ui_fs text_col ;
	(if is_empty m.output => draw_list font m
	 else text font m.output pad top out_fs text_col) ;
	endDrawing {}

# -- frame loop --------------------------------------------------------------
$ frame : Font -> <Ui, Loop, @io> {} = \font =
	when (windowShouldClose {} == 1) (\_ = break {}) ;
	scan_step {} ;
	edit_step {} ;
	scroll_step {} ;
	draw_step font ;
	click_step {} ;
	enter_step {}

$ @main : @vec @str -> <@io> @int = \args =
	let scan = popen {scan_cmd, "r"} in
	setConfigFlags (@cast flag_window_undecorated) ;
	initWindow { .p0 = base_w, .p1 = base_h, .p2 = "" } ;
	setTargetFPS 60 ;
	let font = loadFontEx { .p0 = "bin/font.ttf", .p1 = font_atlas, .p2 = C.null, .p3 = 0 } in
	setTextureFilter { .p0 = font.texture, .p1 = texture_filter_bilinear } ;
	let m0 = Model.{
		.apps = [], .scan = start_scan scan,
		.query = "", .visible = [], .output = "", .off = 0, .typed = @false,
		.win_w = base_w, .win_h = base_h,
	}
	in defer
		closeWindow {},
		unloadFont font
	in
		(with_model m0 <| \_ =
			defer stop_scan {} in
			for forever <| \_ = frame font);
		0
